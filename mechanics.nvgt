int    g_price_face = -1;
int    g_price_product = -1;

/* ==========================================================================
   1.  LEAF HELPERS
   ========================================================================== */

/* Which screens stop the store clock.

   The manager terminal is NOT one of them, and that is deliberate. The shop is
   a real place with a real day: reading the reports, working out an order or
   watching a device install itself does not stop customers walking in or the
   afternoon passing. Only the screens that are the game talking rather than the
   world turning, the pause menu and the sleep prompt, hold the clock still. */
bool clock_is_paused() {
	return g_modal == MODAL_PAUSE
		or g_modal == MODAL_PHONE
		or g_modal == MODAL_ISSUES;
}

bool till_usable() {
	return !g_in_jail and !g_game_over and !g_licence_suspended;
}

array<string> g_emails;
array<string> g_news;

void email_add(const string&in from, const string&in subject) {
	g_emails.insert_last(from + " | " + subject);
	if (g_emails.length() > 40) g_emails.remove_at(0);
	sfx_ui(A("register.ogg"), -14.0, 700);
	diag("phone", "email from " + from + ": " + subject);
}

void news_add(const string&in headline) {
	g_news.insert_last("Day " + g_current_day + " | " + headline);
	if (g_news.length() > 40) g_news.remove_at(0);
}

/* Small readings that the menu pages ask for. They live up here because the
   pages that use them are defined further down, and AngelScript has no
   prototypes: a function must exist before the line that calls it. */
bool g_products_delivered_today() { return false; }
int trouble_short_changeable() { return people_short_change_count_this_week(); }

int shop_draft_lines() {
	int n = 0;
	for (uint i = 0; i < g_draft_qty.length(); i++) if (g_draft_qty[i] > 0) n++;
	return n;
}

int shop_draft_total_estimate_fill() {
	int total = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		int want = p.capacity - p.stock;
		if (want > 0) total += p.cost * want;
	}
	return total;
}

int staff_rota_shift_count_of(applicant@ a) {
	if (@a is null) return 0;
	int n = 0;
	for (uint d = 0; d < a.rota.length(); d++) if (a.rota[d] != SHIFT_OFF) n++;
	return n;
}

/* ==========================================================================
   2.  MENU PRIMITIVES
   ========================================================================== */

/* Which machine, if any, owns the screen in front of the player. -1 means the
   screen is the player's own: the register, the pause menu, the issue reporter
   and everything on the shop floor. The terminal and the phone are the two
   machines with a chip in them, and when one of them is what the player is
   using, that chip is what speaks. */
int machine_for_modal() {
	if (g_modal == MODAL_COMPUTER) return HW_DEVICE_TERMINAL;
	if (g_modal == MODAL_PHONE) return HW_DEVICE_PHONE;
	return -1;
}

/* A machine's screen moves like the player's own voice does: the line the cursor
   leaves stops before the line it lands on is read. The player's channel gets
   this from say(), which interrupts; a chip line is queued, so without this the
   machine would still be finishing the last line while the new one waited its
   turn. Nothing is cut when the screen belongs to the player: their voice is
   already interrupting itself. */
void machine_chip_cut() {
	int machine = machine_for_modal();
	if (machine >= 0) chip_stop_device(machine);
}

/* The machine switching on or off: a short chime of its own, played in the room
   the machine is in, or in the player's own head for the phone they carry. It is
   not speech, so it does not go through the chip or the voice pool; it is here
   because a screen that appears with no sound at all reads as a glitch rather
   than as a machine. */
void machine_power_sound(int device, bool on) {
	if (device < 0 or !g_power_on) return;
	string cue;
	if (device == CHIP_DEVICE_PHONE) cue = on ? A("tech_phone_on.wav") : A("tech_phone_off.wav");
	else cue = on ? A("tech_terminal_on.wav") : A("tech_terminal_off.wav");
	sfx_ui(cue, -4.0);
}

/* One line of a menu, in the voice that owns the screen: a machine's own chip
   when a machine is what the player is using, and the player's voice for
   everything else. Every line a menu says goes through here, so a screen cannot
   end up half read by the screen reader and half by the machine. */
void menu_line_spoken(const string&in text) {
	int machine = machine_for_modal();
	if (machine >= 0) { machine_chip_line(machine, text); return; }
	say(text, true);
}

void menu_speak_current(bool with_title) {
	if (g_menu.length() == 0) return;
	/* A machine's line is queued rather than interrupting, so the line the cursor
	   has just left has to be dropped here or it plays on over the new one. */
	machine_chip_cut();
	menu_page@ p = g_menu[g_menu.length() - 1];
	if (p.count() == 0) { menu_line_spoken(p.title + ". Nothing is available here."); return; }
	string prefix = with_title ? (p.title + ". ") : "";
	string tail = " " + (p.index + 1) + " of " + p.count() + ".";
	if (p.count() == 1) tail = "";
	menu_line_spoken(prefix + p.labels[p.index] + tail);
}

int current_action() {
	if (g_menu.length() == 0) return ACT_CLOSE;
	menu_page@ p = g_menu[g_menu.length() - 1];
	if (p.count() == 0) return ACT_CLOSE;
	return p.actions[p.index];
}

/* Leaving the sound output list without confirming: the game goes back onto the
   device it came in on, and nothing is written. Cheap when nothing is on trial,
   which is why it is the first line of every Back and every close. */
void device_trial_release() {
	if (!out_device_on_trial()) return;
	device_test_sweep_stop();
	out_device_trial_abandon();
}

void mechanics_close_modal() {
	if (g_modal != MODAL_NONE) diag("modal", "closing modal " + g_modal);
	device_trial_release();
	g_menu.resize(0);
	g_modal = MODAL_NONE;
	/* Whoever was speaking is done speaking, so the next line is the player's own
	   channel again. */
	voice_clear();
}

void menu_back() {
	if (g_menu.length() == 0) { mechanics_close_modal(); return; }
	device_trial_release();
	g_menu.remove_last();
	if (g_menu.length() == 0) { mechanics_close_modal(); return; }
	sfx_tick();   /* a tick, not the whole sweep */
	menu_speak_current(true);
}

void menu_push(menu_page@ page) {
	g_menu.insert_last(page);
	menu_speak_current(true);
}

/* Swap the page the player is on for a freshly built one, leaving the cursor on
   the line whose label starts with the prefix it was on before. A machine's own
   screen changes under the player when they change one of its settings, and the
   lines above the one they are on come and go with the shop (the terminal's own
   home page gains a damage line when something is broken), so the cursor is
   found by name rather than by counting. Nothing is spoken: whatever changed the
   page has already answered, and the next move of the cursor reads the new
   line. */
void menu_replace_current(menu_page@ page, const string&in prefix) {
	if (g_menu.length() == 0) { g_menu.insert_last(page); return; }
	g_menu[g_menu.length() - 1] = page;
	menu_page@ now = g_menu[g_menu.length() - 1];
	for (int i = 0; i < now.count(); i++) {
		if (now.labels[uint(i)].find_first(prefix) == 0) { now.index = i; return; }
	}
}

/* ==========================================================================
   3.  THE IDENTIFICATION SCANNER AND THE ALCOHOL BOARD
   ========================================================================= */

void log_id_scan(const string&in item) {
	g_id_scans_logged++;
	sfx_ui(A("id_card.ogg"), -3.0);
	diag("board", "ID scanner read for " + item + ", scan " + g_id_scans_logged);
}

void board_note_sale(bool restricted, bool id_scanned) {
	if (!restricted) return;
	g_restricted_sales++;
	if (!id_scanned) {
		g_unscanned_sales++;
		log_line("board", "restricted sale with no ID scan, " + g_unscanned_sales + " so far");
	}
}

/* Once a month, on a day and at an hour nobody can predict, an inspector comes
   to the till and reads the log. */
void board_schedule_inspection() {
	g_inspection_due_day = int(g_current_day) + random(14, 28);
	g_inspection_hour = random(8, 21);
	diag("board", "next inspection scheduled for day " + g_inspection_due_day);
}

void board_run_inspection() {
	if (g_licence_suspended) {
		say("The alcohol board's inspector comes to the till, and finds your licence is already suspended. "
			+ "They write that down too.", true);
		return;
	}
	if (g_unscanned_sales == 0) {
		say("An inspector from the alcohol board comes to the till and reads the log. "
			+ "Every restricted sale has a scan against it. They thank you, and leave. "
			+ "Nothing to answer.", true);
		sfx_ui(A("register.ogg"), -10.0, 700);
		log_line("board", "clean inspection");
	} else {
		int fine = g_unscanned_sales * 50000;
		int sales = g_unscanned_sales;
		g_unscanned_sales = 0;
		g_bad_inspections++;
		g_fines_from_board += fine;
		sfx_ui(A("siren.ogg"), -12.0);
		say("An inspector from the alcohol board comes to the till and reads the log. "
			+ plural(sales, "sale", "sales") + " of alcohol, tobacco or vapes went through with no "
			+ "identification scan against it. That is " + money(fine) + " in fines, "
			+ "and it is collected on bill day.", true);
		if (g_bad_inspections >= 3) {
			g_licence_suspended = true;
			g_suspension_weeks_left = 12;
			say("That is your third bad inspection, so your licence to sell alcohol, tobacco and vapes "
				+ "is suspended for three months. The lines stay on the shelves, but nobody can buy them, "
				+ "and you cannot order any more. Any bad inspection after this loses the licence for good.", true);
			log_line("board", "licence suspended");
		}
		log_line("board", "bad inspection, fine " + money(fine));
	}
	g_restricted_sales = 0;
}

void board_check_inspection() {
	if (g_inspection_due_day == 0) return;
	if (int(g_current_day) < g_inspection_due_day) return;
	if (int(g_current_hour) < g_inspection_hour) return;
	if (int(g_current_hour) > g_inspection_hour + 1) return;
	board_run_inspection();
	board_schedule_inspection();
}

void board_run_inspection_forced() { board_run_inspection(); }

/* ==========================================================================
   4.  THE TILL: SERVING A CUSTOMER
   ========================================================================= */

customer@ g_sale_customer = null;
array<int> g_sale_line;      /* catalogue indices, in basket order */
array<int> g_sale_qty;
array<int> g_sale_scanned;   /* 0 not scanned, 1 scanned, 2 refused */
int  g_sale_total = 0;
bool g_sale_id_needed = false;
bool g_sale_id_checked = false;
bool g_sale_card = false;
int  g_sale_offered = 0;
int  g_sale_drink_cost = 0;   /* a drink was poured and charged before the lines */
int  g_sale_change_due = 0;
bool g_sale_change_given = false;
bool g_sale_active = false;
/* A fuel sale has no lines to scan: the customer named their litres at the
   till and the bill is the litres times the sign. g_sale_fuel_litres is what
   the tank can actually put out, which can be less than they asked for. */
bool g_sale_fuel = false;
int  g_sale_fuel_litres = 0;

void sale_reset() {
	@g_sale_customer = null;
	g_sale_line.resize(0);
	g_sale_qty.resize(0);
	g_sale_scanned.resize(0);
	g_sale_total = 0;
	g_sale_id_needed = false;
	g_sale_id_checked = false;
	g_sale_card = false;
	g_sale_offered = 0;
	g_sale_drink_cost = 0;
	g_sale_change_due = 0;
	g_sale_change_given = false;
	g_sale_active = false;
	g_sale_fuel = false;
	g_sale_fuel_litres = 0;
}

int sale_restricted_remaining() {
	int n = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		product@ p = product_at(g_sale_line[i]);
		if (@p !is null and p.restricted and g_sale_scanned[i] != 2) n++;
	}
	return n;
}

int sale_behind_counter_remaining() {
	int n = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		product@ p = product_at(g_sale_line[i]);
		if (@p !is null and p.face == FACE_COUNTER and g_sale_scanned[i] == 0) n++;
	}
	return n;
}

bool sale_all_scanned() {
	for (uint i = 0; i < g_sale_line.length(); i++) if (g_sale_scanned[i] == 0) return false;
	return true;
}

int sale_unscanned_count() {
	int n = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) if (g_sale_scanned[i] == 0) n++;
	return n;
}

void sale_recompute_total() {
	int total = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		if (g_sale_scanned[i] != 1) continue;
		product@ p = product_at(g_sale_line[i]);
		if (@p is null) continue;
		total += p.price * g_sale_qty[i];
	}
	g_sale_total = total;
}

void sale_fetch_counter() {
	/* Bring the restricted goods out of the cabinet. Stock comes off the cabinet
	   shelf, not the aisle. */
	int fetched = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		product@ p = product_at(g_sale_line[i]);
		if (@p is null or p.face != FACE_COUNTER or g_sale_scanned[i] != 0) continue;
		fetched++;
	}
	if (fetched == 0) { say("Nothing here comes from behind the counter.", true); return; }
	sfx_ui(A("door_open.ogg"), -12.0);
	say("You fetch " + plural(fetched, "line", "lines") + " from behind the counter and put them on the mat.", true);
	/* Mark them as fetched by leaving them unscanned but recording the trip. */
	for (uint i = 0; i < g_sale_line.length(); i++) {
		product@ p = product_at(g_sale_line[i]);
		if (@p is null or p.face != FACE_COUNTER or g_sale_scanned[i] != 0) continue;
		g_sale_scanned[i] = 0;
	}
	/* A flag so the page stops offering it. */
	g_sale_offered = 1;
}

void sale_scan_index(int i, bool quiet) {
	if (i < 0 or uint(i) >= g_sale_line.length()) return;
	if (g_sale_scanned[i] == 2) return;
	product@ p = product_at(g_sale_line[i]);
	if (@p is null) return;
	if (p.stock <= 0) {
		say(p.name + " is out of stock, so it comes off the basket.", true);
		g_sale_scanned[i] = 2;
		return;
	}
	int qty = g_sale_qty[i];
	if (qty > p.stock) qty = p.stock;
	int take = qty * p.price;
	shop_sell(g_sale_line[i], qty);
	g_sale_scanned[i] = 1;
	g_sale_total += take;
	sfx_ui(A("scanner.ogg"), -8.0);
	if (!quiet) {
		say(p.name + ", " + money(p.price) + " each, " + plural(qty, "unit", "units")
			+ ". The running total is " + money(g_sale_total) + ".", false);
	}
}

/* A receipt prints after every sale, and about half of the customers wave it
   away. Kept as its own function so the two halves are visible apart. */
bool sale_waves_receipt() { return random(1, 100) <= 50; }

void sale_finish(bool paid) {
	customer@ c = g_sale_customer;
	if (@c !is null) {
		c.served = true;
		c.bought = paid;
		c.spent = g_sale_total;
		c.id_checked = g_sale_id_checked;
		c.state = CUST_LEAVING;
		/* Take them out of the queue and send them to the door. */
		for (int i = int(g_queue.length()) - 1; i >= 0; i--) if (g_queue[i] is c) g_queue.remove_at(uint(i));
		if (paid) {
			people_event(c, EV_SERVED);
			if (g_sale_id_checked) people_event(c, EV_ID_ASKED);
			/* A drink that was charged for has been drunk, and a drunk who drinks
			   is further in than they were when they came in. */
			if (c.wants_drink and g_sale_drink_cost > 0) people_drink_count_add(c);
			sfx_ui(A("register.ogg"), -8.0);
			/* Fuel was paid for before it moves: the tank gives up the litres
			   now, and the pump starts when the driver reaches the car. */
			if (g_sale_fuel) {
				c.fuel_litres = g_sale_fuel_litres;
				fuel_take(g_sale_fuel_litres);
			}
			/* A receipt prints after the sale, and about half of them wave it
			   away. It matters to the one in ten who comes back about their
			   change, which is the whole point of a receipt. */
			c.waved_receipt = sale_waves_receipt();
			if (g_sale_fuel) {
				say("The drawer opens and the sale is rung up. A receipt prints, and " + c.name + " "
					+ (c.waved_receipt ? "waves it away" : "folds it into a pocket")
					+ ", and heads back out to the car on pump " + fuel_pump_word(c.fuel_pump) + ". That is "
					+ money(g_sale_total) + " for " + plural(g_sale_fuel_litres, "litre", "litres")
					+ " of unleaded.", true);
			} else {
				say("The drawer opens and the sale is rung up. A receipt prints, and " + c.name + " "
					+ (c.waved_receipt ? "waves it away" : "folds it into a pocket")
					+ ", takes their bag and heads for the door. That is " + money(g_sale_total) + ".", true);
			}
			email_add("The till", "Sale of " + money(g_sale_total));
		} else {
			say(c.name + " leaves with nothing.", true);
		}
	}
	sale_reset();
	mechanics_close_modal();
}

void sale_money_in(int cents, bool from_card) {
	if (cents <= 0 and from_card) {
		/* A card sale needs no change. */
	}
	money_earn(cents);
	g_wk_customers++;
	board_note_sale(false, g_sale_id_checked);
}

/* Take the money. A card never opens the drawer, and can be declined. Whether
   this card is one of the dead ones is the customer's own bad luck: the chance
   comes from them, not from the till (see people_card_decline_chance). */
void sale_take_card() {
	customer@ c = g_sale_customer;
	if (@c !is null and !c.has_card) {
		sfx_ui(A("knock.wav"), -10.0);
		say("They do not have a card on them. It is cash or nothing.", true);
		return;
	}
	sfx_ui(A("id_card.ogg"), -6.0);
	int bad = people_card_decline_chance(c);
	if (random(1, 100) <= bad) {
		sfx_ui(A("knock.wav"), -10.0);
		say("The card is declined.", true);
		/* They either pay cash instead, or have nothing else. */
		if (random(1, 100) <= 55) {
			g_sale_offered = 1;      /* now offering cash */
			say("They dig around and find cash instead. Take it.", true);
			return;
		}
		say("They have nothing else on them. The sale is off, and the goods go back on the shelves.", true);
		for (uint i = 0; i < g_sale_line.length(); i++) {
			if (g_sale_scanned[i] != 1) continue;
			product@ p = product_at(g_sale_line[i]);
			if (@p is null) continue;
			p.stock += g_sale_qty[i];
		}
		if (@c !is null) c.mood -= 3;
		sale_finish(false);
		return;
	}
	g_sale_card = true;
	sale_money_in(g_sale_total, true);
	say("The card goes through for " + money(g_sale_total) + ". Nothing to count out, and the drawer stays shut.", true);
	sale_finish(true);
}

void sale_take_cash(int offered) {
	g_sale_card = false;
	g_sale_offered = offered;
	g_sale_change_due = offered - g_sale_total;
	if (g_sale_change_due < 0) g_sale_change_due = 0;
	sfx_ui(A("coins.ogg"), -6.0);
	if (g_sale_change_due == 0) {
		sale_money_in(offered, false);
		say("The exact money, " + money(offered) + ". The drawer opens.", true);
		sale_finish(true);
		return;
	}
	say("You take " + money(offered) + ", and you owe " + money(g_sale_change_due) + " in change.", true);
	/* The page now offers to count the change out. */
	g_sale_change_given = false;
}

string sale_change_page_text() {
	return "You owe " + money(g_sale_change_due) + " in change";
}

void sale_count_change() {
	if (g_sale_change_due <= 0) return;
	sfx_ui(A("coins.ogg"), -4.0);
	say("You count " + money(g_sale_change_due) + " across the counter. The customer takes it and goes.", true);
	g_sale_change_given = true;
	/* Their note goes in the drawer and the change comes back out of it, so the
	   drawer is up by the sale, not by what they handed over. */
	sale_money_in(g_sale_total, false);
	sale_finish(true);
}

/* ---- when the money in their hand does not cover the basket ---------------
   Everybody walks in with a wallet and some wallets are thinner than the basket,
   which is the reference game's arrangement. Nothing here stops the sale: the
   till offers what is actually possible, and every one of them leaves a mark on
   the customer to remember. */

/* What they can actually put on the counter, and how far short that leaves
   them. The drink was poured and charged when the sale opened, so it is part of
   what they owe. */
int sale_wallet_cash() {
	customer@ c = g_sale_customer;
	if (@c is null) return g_sale_total + g_sale_drink_cost;
	return (c.wallet < (g_sale_total + g_sale_drink_cost)) ? c.wallet : (g_sale_total + g_sale_drink_cost);
}

bool sale_wallet_covers_all() {
	customer@ c = g_sale_customer;
	if (@c is null) return true;
	return c.wallet >= (g_sale_total + g_sale_drink_cost);
}

int sale_wallet_short_by() {
	int due = g_sale_total + g_sale_drink_cost;
	int cash = sale_wallet_cash();
	return (cash >= due) ? 0 : (due - cash);
}

/* Take everything they have and let the rest go, telling them how much short it
   left and how much you are letting them off. */
void sale_take_short_payment() {
	customer@ c = g_sale_customer;
	if (@c is null) return;
	if (sale_wallet_covers_all()) { sale_take_cash(g_sale_total); return; }
	int cash = sale_wallet_cash();
	int short_by = sale_wallet_short_by();
	c.could_not_pay = true;
	c.short_paid += short_by;
	c.mood -= 3;
	people_event(c, EV_COULD_NOT_PAY);
	people_drunk_no_drink(c);
	money_earn(cash);
	g_wk_customers++;
	board_note_sale(false, g_sale_id_checked);
	say("You take " + money(cash) + ", which is everything they have. That leaves "
		+ money(short_by) + " short, and it is yours to write off. " + c.name
		+ " knows it, and will remember it.", true);
	sale_finish(true);
}

/* Sell only the lines their money covers: the dearest lines come off the bill
   and go back on the shelf until the rest fits in the wallet. */
void sale_sell_covers() {
	customer@ c = g_sale_customer;
	if (@c is null) return;
	if (g_sale_fuel) {
		/* Fuel comes off in whole litres: they get what their money buys at the
		   sign, and the rest of the fill is quietly not put through. */
		int afford = c.wallet / g_fuel_price;
		if (afford >= g_sale_fuel_litres) {
			say("Nothing has to come off: their money covers the fill after all.", true);
			return;
		}
		if (afford < 0) afford = 0;
		g_sale_fuel_litres = afford;
		g_sale_total = afford * g_fuel_price;
		c.mood -= 1;
		say("You ring up " + plural(afford, "litre", "litres") + ", " + money(g_sale_total)
			+ ", which is what their money covers. That is "
			+ plural(c.fuel_litres - afford, "litre", "litres") + " short of the fill they asked for.", true);
		return;
	}
	int budget = c.wallet;
	int left_off = 0;
	bool again = true;
	while (again and (g_sale_total + g_sale_drink_cost) > budget) {
		again = false;
		int worst = -1, worst_line = 0;
		for (uint i = 0; i < g_sale_line.length(); i++) {
			if (g_sale_scanned[i] != 1) continue;
			product@ p = product_at(g_sale_line[i]);
			if (@p is null) continue;
			int line_total = p.price * g_sale_qty[i];
			if (line_total > worst_line) { worst_line = line_total; worst = int(i); }
		}
		if (worst < 0) break;
		product@ p = product_at(g_sale_line[worst]);
		if (@p !is null) {
			/* One unit at a time, so three of something becomes two rather than
			   nothing at all, and the figures follow the shelf. */
			shop_unsell(g_sale_line[worst], 1);
			g_sale_qty[worst] -= 1;
			left_off += p.price;
			if (g_sale_qty[worst] <= 0) g_sale_scanned[worst] = 2;   /* off the bill */
			sale_recompute_total();
			again = true;
		}
	}
	c.mood -= 1;
	if (left_off <= 0) {
		say("Nothing has to come off: their money covers the basket after all.", true);
		return;
	}
	say("You put " + money(left_off) + " of it back on the shelves and ring up "
		+ money(g_sale_total) + ", which is what they can pay. That leaves them "
		+ money(sale_wallet_short_by()) + " short of the whole basket.", true);
}

/* The drink has already been poured and cannot go back, so this gives it away
   and takes it off the till. */
void sale_free_drink() {
	customer@ c = g_sale_customer;
	if (@c is null or !c.wants_drink or g_sale_drink_cost <= 0) {
		say("There is no drink in this sale.", true);
		return;
	}
	g_cash -= g_sale_drink_cost;
	if (g_cash < 0) g_cash = 0;
	c.short_paid += g_sale_drink_cost;
	c.mood += 1;
	say("The " + ((c.drink_kind == 0) ? "coffee" : "fountain drink") + " has already been poured, "
		+ "so it cannot go back on the shelf. You let them have it for nothing.", true);
	g_sale_drink_cost = 0;
}

/* Refuse the whole sale: everything goes back and they leave with nothing. */
void sale_refuse_sale() {
	customer@ c = g_sale_customer;
	if (@c is null) return;
	int restocked = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		if (g_sale_scanned[i] != 1) continue;
		product@ p = product_at(g_sale_line[i]);
		if (@p is null) continue;
		p.stock += g_sale_qty[i];
		restocked += g_sale_qty[i];
	}
	c.could_not_pay = true;
	c.mood -= 4;
	people_event(c, EV_COULD_NOT_PAY);
	people_drunk_no_drink(c);
	if (g_sale_fuel) {
		say("You tell " + c.name + " the fill cannot go through after all. They look around for another station and leave the car where it is.", true);
	} else {
		say("You refuse the sale. " + plural(restocked, "item goes", "items go") + " back on the shelves, and "
			+ c.name + " leaves with nothing.", true);
	}
	sale_finish(false);
}

/* Somebody walks away mid sale. That is how short change happens. */
void sale_walk_away() {
	customer@ c = g_sale_customer;
	if (@c !is null) {
		if (!g_sale_change_given and g_sale_change_due > 0 and !g_sale_card) {
			people_note_short_change(c, g_sale_change_due);
			g_short_change_events++;
			g_sale_offered = 0;
			say("You step away from the till without counting out " + money(g_sale_change_due)
				+ ". You have short changed " + c.name + ", and they will remember.", true);
			g_cash -= 0;
			/* You keep money you should have given back. The till is not
			   credited, because the sale is not settled. */
			g_sale_change_due = 0;
		} else {
			say("You step away from the till. The sale is left where it is.", true);
		}
	}
	sale_reset();
	mechanics_close_modal();
}

void sale_open() {
	customer@ c = people_queue_head();
	if (@c is null) {
		say("There is nobody at the counter. The till keeps itself up to date, so it will notice when somebody walks up.", true);
		return;
	}
	sale_reset();
	g_sale_active = true;
	@ g_sale_customer = c;
	c.state = CUST_SERVING;
	/* Everything said over the counter from here until the sale closes belongs to
	   the customer standing in front of you. */
	voice_use(c.voice);
	if (c.fuel_litres > 0) {
		/* A driver's bill is the litres they named times the sign, and nothing
		   is scanned. What the tank can actually give can be less than they
		   asked for, and that is decided here, before any money moves. */
		g_sale_fuel = true;
		int have = g_fuel_litres;
		int give = (c.fuel_litres > have) ? have : c.fuel_litres;
		g_sale_fuel_litres = give;
		g_sale_total = give * g_fuel_price;
	} else {
		/* Copy their basket. */
		for (uint i = 0; i < c.basket.length(); i++) {
			g_sale_line.insert_last(c.basket[i]);
			g_sale_qty.insert_last(c.basket_qty[i]);
			g_sale_scanned.insert_last(0);
		}
	}
	/* Everybody walks in with a wallet. If the basket was filled off a shelf this
	   was counted then; a customer handed a basket another way gets counted here,
	   so no sale can happen without knowing what the person in front of you can
	   actually pay. */
	if (!c.wallet_known) { c.wallet = people_wallet_for(c); c.wallet_known = true; }
	g_sale_id_needed = people_basket_has_restricted(c);
	if (c.wants_drink) {
		int kind = (c.drink_kind == DRINK_COFFEE) ? DRINK_COFFEE : DRINK_FOUNTAIN;
		if (c.drink_poured) {
			/* Already poured at the machine by the drink server on shift or by
			   the customer on self serve. */
			int table_cost = c.drink_cost;
			g_sale_drink_cost = table_cost;
			if (table_cost > 0) money_earn(table_cost);
			string who = (c.drink_poured_by.length() > 0)
				? (c.drink_poured_by + " already poured their " + drink_word(kind) + " at " + drink_station_word(kind) + ".")
				: ("They already poured their own " + drink_word(kind) + " at " + drink_station_word(kind) + ".");
			if (table_cost > 0) say(who + " " + money(table_cost) + " has gone on the bill.", true);
			else say(who, true);
		} else if (drink_station_damaged(kind)) {
			c.wants_drink = false;
			c.mood -= 2;
			people_event(c, EV_BARE);
			say("They ask for a " + drink_word(kind) + ", but " + drink_station_word(kind) + " is knocked over.", true);
		} else {
			worker@ srv = staff_on_duty(ROLE_SERVER);
			if (@srv !is null) {
				int table_cost = staff_server_pour(srv, kind, c.name);
				c.drink_poured = true;
				c.drink_cost = table_cost;
				c.drink_poured_by = srv.name;
				g_sale_drink_cost = table_cost;
				if (table_cost > 0) money_earn(table_cost);
				say("They also want a " + drink_word(kind) + ". " + srv.name + " pours it at "
					+ drink_station_word(kind) + ". "
					+ ((table_cost > 0) ? (money(table_cost) + " has gone on the bill.") : ""), true);
			} else {
				/* You pour it yourself (or they pour it now on self serve). */
				int table_cost = drink_price_cents(kind);
				float sx, sy;
				drink_station_pos(kind, sx, sy);
				c.drink_poured = true;
				c.drink_cost = table_cost;
				g_sale_drink_cost = table_cost;
				money_earn(table_cost);
				sfx_at(ROOM_SHOP, sx, sy, 0.0, A("pump.mp3"), -14.0, DRINK_POUR_CUT_MS);
				say("They also want a " + drink_word(kind) + ". "
					+ ((g_drinks_self_serve == 1) ? "They pour it themselves." : "You pour it for them.") + " "
					+ money(table_cost) + " has gone on the bill.", true);
			}
		}
	}
	sfx_ui(A("register.ogg"), -16.0, 700);
	string s = "";
	if (g_sale_fuel) {
		s = c.name + ", " + people_kind_word(c) + ", at the counter here for "
			+ plural(c.fuel_litres, "litre", "litres") + " of unleaded on pump " + fuel_pump_word(c.fuel_pump)
			+ ". At " + money(g_fuel_price) + " a litre that is " + money(c.fuel_litres * g_fuel_price) + ".";
		if (g_sale_fuel_litres < c.fuel_litres) {
			s += " The tank holds only " + plural(g_fuel_litres, "litre", "litres") + ", so that is all you can put on.";
		}
		if (g_sale_fuel_litres <= 0) {
			s += " The tank is dry, so there is nothing you can sell them.";
		}
	} else {
		s = c.name + ", " + people_kind_word(c) + ", at the counter with "
			+ plural(people_basket_lines(c), "line", "lines") + " in their basket.";
	}
	if (g_sale_id_needed) s += " Something in there is age restricted, so it needs an identification scan.";
	if (c.wants_drink) s += " They want a drink as well.";
	/* A regular says what they remember about last time before anything else. */
	string memory = people_regular_line(c);
	if (memory.length() > 0) s += " " + memory;
	say(s, true);
	/* The serving page itself is built by the caller, so that this file stays in
	   strict bottom up order. */
}

/* ==========================================================================
   5.  THE SERVING PAGE
   ========================================================================== */

void sale_page_build() {
	if (!g_sale_active) return;
	g_modal = MODAL_REGISTER;
	menu_page@ p = menu_page("Serving " + ((@g_sale_customer !is null) ? g_sale_customer.name : "a customer")
		+ ", total so far " + money(g_sale_total));

	int behind = sale_behind_counter_remaining();
	if (behind > 0 and g_sale_offered != 1) {
		p.add("Get " + plural(behind, "line", "lines") + " from behind the counter first", ACT_SERVE_FETCH);
		menu_push(p);
		return;
	}
	if (!sale_all_scanned()) {
		p.add("Scan the next line", ACT_SERVE_SCAN_ONE);
		int rest = sale_unscanned_count();
		if (rest > 1) p.add("Scan the rest of the basket, " + plural(rest, "line", "lines"), ACT_SERVE_SCAN_REST);
	}
	if (g_sale_id_needed and !g_sale_id_checked and sale_restricted_remaining() > 0) {
		p.add("Ask for identification", ACT_SERVE_ASK_ID);
		p.add("Refuse the age restricted lines", ACT_SERVE_REFUSE_REST);
	}
	if (g_sale_fuel and g_sale_total <= 0) {
		/* The tank is dry: there is nothing to charge for and nothing to scan. */
		p.add("Tell them the tank is dry and send them on their way", ACT_SERVE_REFUSE_SALE);
		p.add("Step away from the till", ACT_SERVE_WALK_AWAY);
		if (g_menu.length() == 0) menu_push(p);
		else { g_menu[g_menu.length() - 1] = p; menu_speak_current(true); }
		return;
	}
	if (sale_all_scanned() and (int(g_sale_total) > 0)) {
		/* Only somebody with a card in their pocket can have it run. Whether it
		   goes through is the card's business, and the customer's: see
		   sale_take_card. */
		customer@ pc = g_sale_customer;
		if (@pc is null or pc.has_card) {
			p.add("Run the card for " + money(g_sale_total), ACT_SERVE_CARD);
		}
		if (sale_wallet_covers_all()) {
			p.add("Take " + money(g_sale_total) + ", the exact money", ACT_SERVE_CASH_EXACT);
			int rounded = ((g_sale_total / 500) + 1) * 500;
			if (rounded > g_sale_total) {
				p.add("Take " + money(rounded) + ", " + money(rounded - g_sale_total) + " change", ACT_SERVE_CASH_ROUND);
			}
		} else {
			/* The money in their hand does not cover the basket. Offer what is
			   actually possible, and say exactly how short it is. */
			p.add("Take " + money(sale_wallet_cash()) + ", all they have, "
				+ money(sale_wallet_short_by()) + " short", ACT_SERVE_CASH_WALLET);
			p.add("Sell what their money covers", ACT_SERVE_SELL_COVERS);
			customer@ c = g_sale_customer;
			if (@c !is null and c.wants_drink and c.short_paid == 0) {
				p.add("Give them the drink for nothing", ACT_SERVE_FREE_DRINK);
			}
			p.add("Refuse the sale", ACT_SERVE_REFUSE_SALE);
		}
	}
	if (g_sale_change_due > 0 and !g_sale_change_given) {
		p.add("Count out the change, " + money(g_sale_change_due), ACT_SERVE_COUNT_CHANGE);
	}
	p.add("Step away from the till", ACT_SERVE_WALK_AWAY);
	if (g_menu.length() == 0) menu_push(p);
	else { g_menu[g_menu.length() - 1] = p; menu_speak_current(true); }
}

/* How often somebody actually has their licence on them. */
const int ID_PRODUCED_CHANCE = 82;

bool sale_id_will_be_produced() {
	return (random(1, 100) <= ID_PRODUCED_CHANCE);
}

/* They have it, and it goes in the log. Kept apart from the roll above so the
   behaviour can be driven without waiting for the 82 percent to come up. */
void sale_id_produced() {
	log_id_scan("the restricted lines");
	g_sale_id_checked = true;
	say("They slide a licence through the reader. It beeps, and the scan goes in the log.", true);
	sale_page_build();
}

/* They have nothing to show you, so the restricted lines stay in the drawer. */
void sale_id_missing() {
	say("They pat their pockets and have nothing to show you. No identification, no sale of those lines.", true);
	sale_refuse_restricted();
}

void sale_ask_id() {
	if (sale_id_will_be_produced()) sale_id_produced();
	else sale_id_missing();
}

void sale_refuse_restricted() {
	int refused = 0;
	int units = 0;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		product@ p = product_at(g_sale_line[i]);
		if (@p is null or !p.restricted) continue;
		if (g_sale_scanned[i] == 2) continue;
		g_sale_scanned[i] = 2;
		refused++;
		units += g_sale_qty[i];
	}
	if (@g_sale_customer !is null) g_sale_customer.id_refused = true;
	say("You put " + plural(refused, "line", "lines") + ", " + plural(units, "unit", "units")
		+ ", back under the counter. Everything else stays on the bill.", true);
	sale_recompute_total();
	sale_page_build();
}

void sale_scan_one() {
	for (uint i = 0; i < g_sale_line.length(); i++) {
		if (g_sale_scanned[i] != 0) continue;
		sale_scan_index(int(i), false);
		break;
	}
	sale_page_build();
}

void sale_scan_rest() {
	int first = 1;
	for (uint i = 0; i < g_sale_line.length(); i++) {
		if (g_sale_scanned[i] != 0) continue;
		sale_scan_index(int(i), first == 1 ? false : true);
		first++;
	}
	sfx_ui(A("scanner.ogg"), -10.0);
	say("You scan the rest of the basket in one go. The total is " + money(g_sale_total) + ".", true);
	sale_page_build();
}

/* ==========================================================================
   6.  THE TILL MENU
   ========================================================================= */

void open_register() {
	if (g_game_over) { say("The shop is closed.", true); return; }
	if (g_in_jail) { say("Not from a cell.", true); return; }
	if (g_licence_suspended) {
		say("Your licence to sell alcohol, tobacco and vapes is suspended for another "
			+ g_suspension_weeks_left + " weeks, but you can still sell everything else.", true);
	}
	g_modal = MODAL_REGISTER;
	g_menu.resize(0);
	menu_page@ p = menu_page("Cash register. The till holds " + money(g_cash)
		+ ". " + plural(people_queue_length(), "customer is", "customers are") + " waiting");
	p.add("Serve whoever is at the counter", ACT_SERVE_FETCH);
	p.add("Open the drawer and count it", ACT_REP_TILL);
	p.add("Count the till out", ACT_COMP_LOGOFF);
	p.add("Close the register", ACT_CLOSE);
	menu_push(p);
}

/* ==========================================================================
   7.  THE MANAGER TERMINAL
   ========================================================================== */

menu_page@ computer_home_page() {
	string title = "Manager terminal for " + g_store_name + ". The till holds " + money(g_cash);
	if (g_arrears > 0) title += ". You owe " + money(g_arrears) + " in unpaid bills";
	if (g_products_delivered_today()) title += ". The truck has already been";
	menu_page@ p = menu_page(title);
	p.add("Restock order", ACT_COMP_RESTOCK);
	if (trouble_damaged_count() > 0 or g_pending_insurance_claim > 0 or trouble_short_changeable() > 0) {
		p.add("Damage and theft", ACT_COMP_DAMAGE);
	}
	p.add("Bills and the bank", ACT_COMP_BILLS);
	p.add("Reports", ACT_COMP_REPORTS);
	p.add("Prices", ACT_COMP_PRICES);
	p.add("Staff", ACT_COMP_STAFF);
	p.add("Policies", ACT_COMP_POLICIES);
	p.add("Hours", ACT_COMP_HOURS);
	p.add("Music", ACT_COMP_MUSIC);
	if (!g_renamed and int(g_current_week) <= 1) p.add("Rename the store", ACT_COMP_RENAME);
	p.add("The law", ACT_COMP_LAW);
	/* The terminal's own speech speed. It is here, on the machine itself, because
	   that is where a player who cannot follow its voice finds out: they are
	   reading a screen off it, and the chip that answers this line is the chip
	   being slowed down. */
	p.add(chip_speed_line(CHIP_DEVICE_COMPUTER), ACT_SPEED_TERM);
	p.add(chip_pitch_line(CHIP_DEVICE_COMPUTER), ACT_PITCH_TERM);
	p.add("Log off", ACT_COMP_LOGOFF);
	return p;
}

/* The phone the player carries. A phone that has never been set up in this
   store runs its own routine first, the same way the terminal does; after that
   Shift+P brings up its pages, which speak through the handset's own chip. */
void open_phone() {
	if (g_game_over) { say("The phone is dead.", true); return; }
	if (!is_phone_initialized) { hardware_phone_setup_begin(); return; }
	/* The chime is the handset switching on, so it belongs to the moment its
	   screens do: a machine still installing itself has not switched on yet, and
	   the hand-off at the end of its routine comes back through here. */
	machine_power_sound(CHIP_DEVICE_PHONE, true);
	g_modal = MODAL_PHONE;
	g_menu.resize(0);
	menu_push(phone_page());
}

void open_computer() {
	if (g_game_over) { say("The terminal is dead.", true); return; }
	/* A terminal that has never been set up in this store does not show its
	   pages yet. It runs its hardware routine, and while it runs the shop keeps
	   trading: the clock is not paused for this and is no longer paused for the
	   terminal either. */
	if (!is_computer_initialized) { hardware_setup_begin(); return; }
	/* The chime is the terminal switching on, so it belongs to the moment its
	   screens do: a machine still installing itself has not switched on yet, and
	   the hand-off at the end of its routine comes back through here. */
	machine_power_sound(CHIP_DEVICE_COMPUTER, true);
	g_modal = MODAL_COMPUTER;
	g_menu.resize(0);
	menu_push(computer_home_page());
}

/* ---- restock order ------------------------------------------------------ */

menu_page@ order_page() {
	string t = "Restock order. The draft comes to " + money(shop_draft_total());
	if (g_account_hold) t += ". Your account is on hold, so orders will be refused";
	menu_page@ p = menu_page(t);
	p.add("Fill every shelf, " + money(shop_draft_total_estimate_fill()) + " approximately", ACT_ORDER_FILL_ALL);
	p.add("Order one aisle", ACT_ORDER_FACE_BASE);
	p.add("Fuel for the forecourt, " + fuel_tank_text(), ACT_ORDER_FUEL);
	p.add("Review the order, " + plural(shop_draft_lines(), "line", "lines") + ", " + money(shop_draft_total()), ACT_ORDER_REVIEW);
	p.add("Place the order", ACT_ORDER_PLACE);
	p.add("Clear the order", ACT_ORDER_CLEAR);
	p.add("Orders already placed, " + shop_order_count() + ", " + money(shop_orders_total()), ACT_ORDER_PLACED);
	p.add("Back", ACT_CLOSE);
	return p;
}

/* Fuel is ordered on its own, by the tanker load, from the same terminal and
   on the same Monday truck as everything else. It never joins the shelf draft:
   it is one product, measured in litres, and the driver hoses it in. */
menu_page@ fuel_order_page() {
	string t = "Fuel by the tanker load. " + fuel_tank_text()
		+ ". It costs " + money(g_fuel_cost) + " a litre wholesale, and comes with the truck on "
		+ day_name(MONDAY) + " morning";
	menu_page@ p = menu_page(t);
	array<int> loads;
	loads.insert_last(200);
	loads.insert_last(500);
	loads.insert_last(1000);
	for (uint i = 0; i < loads.length(); i++) {
		int litres = loads[i];
		string line = plural(litres, "load", "loads") + ", " + money(litres * g_fuel_cost) + ", "
			+ (g_fuel_litres + litres > FUEL_TANK_CAPACITY ? FUEL_TANK_CAPACITY : (g_fuel_litres + litres))
			+ " litres in the tank after";
		if (g_fuel_litres + litres > FUEL_TANK_CAPACITY) line += ", and the rest is more than the tank holds";
		p.add(line, ACT_FUEL_ORDER_BASE + int(i));
	}
	p.add("Back", ACT_BACK);
	return p;
}

menu_page@ order_aisle_page() {
	menu_page@ p = menu_page("Order one aisle. Pick a shelf face to fill");
	for (int f = 0; f < FACE_COUNT; f++) {
		p.add(shop_face_name(f) + ", " + shop_face_theme(f) + ", " + shop_face_stock_pct(f) + " percent full",
			ACT_ORDER_FACE_BASE + f);
	}
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ order_review_page() {
	menu_page@ p = menu_page("Your order, line by line. Enter on a line takes it off");
	int shown = 0;
	for (uint i = 0; i < g_draft_qty.length() and shown < 40; i++) {
		if (g_draft_qty[i] <= 0) continue;
		product@ q = product_at(int(i));
		if (@q is null) continue;
		p.add(q.name + ", " + plural(g_draft_qty[i], "unit", "units") + ", " + money(q.cost * g_draft_qty[i]),
			22000 + int(i));
		shown++;
	}
	if (shown == 0) p.add("The order is empty", ACT_CLOSE);
	p.add("Place the order, " + money(shop_draft_total()), ACT_ORDER_PLACE);
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ order_placed_page() {
	menu_page@ p = menu_page("Orders already placed");
	if (g_orders.length() == 0) p.add("Nothing is on its way", ACT_CLOSE);
	for (uint i = 0; i < g_orders.length(); i++) {
		p.add(money(g_orders[i].total) + ", arriving day " + g_orders[i].arrive_day
			+ ", press Enter to cancel and refund", ACT_ORDER_CANCEL_BASE + int(i));
	}
	p.add("Back", ACT_CLOSE);
	return p;
}

