/* ---- music and the shop's speakers ---------------------------------------
   The music is off when a shop starts and is switched on from the office
   computer, which is how the reference game does it. The tracks are loose
   files rather than being baked in:

     sounds/music   the player's own tracks, scanned first
     assets/music   what the shop ships: four public domain ragtime recordings
                    from Wikimedia Commons and three instrumentals written for
                    this project
     music          anything dropped next to the exe

   Playback goes through the ceiling speakers in audio.nvgt, so the music is a
   sound source in room space and the room isolation table takes it away when
   you walk out of earshot of the speakers. Walking into the cooler or the
   office is therefore enough to stop hearing the shop's music. */
bool   g_music_on = false;
int    g_music_volume = 100;      /* percent; 100 is the recording as it came */
int    g_sub_volume = 0;
bool   g_music_shuffle = false;
array<string> g_music_tracks;     /* full paths, so several folders can feed it */
int    g_music_track = 0;
string g_music_now = "";          /* what the speakers are playing */
string g_music_special = "";      /* "chase" or "fight" while one of those plays */
int    g_music_resume_track = -1; /* the track to go back to afterwards */
bool   g_music_was_on = false;    /* whether the shop's music was on before it */

/* ---- saving -------------------------------------------------------------- */
