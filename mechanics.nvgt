/* ---- prices -------------------------------------------------------------- */

menu_page@ face_price_page(int face) {
	menu_page@ p = menu_page(shop_report_face(face) + ". Pick a line to reprice");
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ q = g_catalog[i];
		if (q.face != face) continue;
		string warn = "";
		if (q.price <= q.cost) warn = ", below cost";
		else if (shop_price_over_fair(int(i)) > PRICE_TOLERANCE_PCT) warn = ", over fair";
		p.add(q.name + ", " + money(q.price) + warn, ACT_PRICE_PROD_BASE + int(i));
	}
	p.add("Adjust every price on this face up five percent", ACT_PRICE_FACE_UP5);
	p.add("Adjust every price on this face up ten percent", ACT_PRICE_FACE_UP10);
	p.add("Adjust every price on this face down five percent", ACT_PRICE_FACE_DOWN5);
	p.add("Adjust every price on this face down ten percent", ACT_PRICE_FACE_DOWN10);
	p.add("Set all on this face to the fair price", ACT_PRICE_FACE_FAIR);
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ product_price_page(int index) {
	product@ q = product_at(index);
	menu_page@ p = menu_page(shop_product_text(index));
	p.add("Up five cents", ACT_PRICE_UP5);
	p.add("Up twenty five cents", ACT_PRICE_UP25);
	p.add("Down five cents", ACT_PRICE_DOWN5);
	p.add("Down twenty five cents", ACT_PRICE_DOWN25);
	p.add("Set to the fair price, " + money((@q !is null) ? q.fair : 0), ACT_PRICE_FAIR);
	p.add("Back", ACT_CLOSE);
	return p;
}

/* The price moved: put a floor under it, write it to the log, and rebuild the
   page so its title quotes the new sign. The cursor stays on the line that
   was pressed, and the fresh title is what answers it. */
void fuel_price_tell(const string&in label) {
	if (g_fuel_price < FUEL_PRICE_FLOOR) g_fuel_price = FUEL_PRICE_FLOOR;
	log_line("shop", "fuel price set to " + g_fuel_price + " a litre");
	menu_replace_current(fuel_price_page(), label);
	menu_speak_current(true);
}

/* The sign by the road: what a litre of unleaded goes for. */
menu_page@ fuel_price_page() {
	string t = "Unleaded. It costs " + money(g_fuel_cost) + " a litre and goes at " + money(g_fuel_price)
		+ " on the sign. " + fuel_tank_text();
	menu_page@ p = menu_page(t);
	p.add("Up five cents", ACT_FUEL_PRICE_UP5);
	p.add("Up twenty five cents", ACT_FUEL_PRICE_UP25);
	p.add("Down five cents", ACT_FUEL_PRICE_DOWN5);
	p.add("Down twenty five cents", ACT_FUEL_PRICE_DOWN25);
	p.add("Set to the fair price, " + money(fuel_fair_price()), ACT_FUEL_PRICE_FAIR);
	p.add("Back", ACT_BACK);
	return p;
}

