menu_page@ staff_list_page() {
	menu_page@ p = menu_page(staff_summary_text());
	for (uint i = 0; i < g_staff.length(); i++) {
		p.add(g_staff[i].name + ", " + staff_role_name(g_staff[i].role) + ", "
			+ staff_mood_word(g_staff[i].satisfaction) + ", " + money(g_staff[i].wage) + " an hour",
			ACT_STAFF_EMP_BASE + int(i));
	}
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ employee_page(int index) {
	if (index < 0 or uint(index) >= g_staff.length()) return staff_list_page();
	worker@ w = g_staff[index];
	menu_page@ p = menu_page(staff_how_they_are_doing(w));
	p.add("Raise their wage by a dollar an hour", ACT_STAFF_RAISE_BASE + index);
	p.add("Cut their wage by a dollar an hour", ACT_STAFF_CUT_BASE + index);
	p.add("Put them on mornings only", ACT_STAFF_ROTA_M_BASE + index);
	p.add("Put them on evenings only", ACT_STAFF_ROTA_E_BASE + index);
	if (g_hours_24h) p.add("Put them on nights only", ACT_STAFF_ROTA_N_BASE + index);
	if (w.request_open) {
		p.add("Grant what they asked for", ACT_STAFF_GRANT_BASE + index);
		p.add("Refuse what they asked for", ACT_STAFF_REFUSE_BASE + index);
	}
	p.add("Fire them", ACT_STAFF_FIRE_BASE + index);
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ applicants_page() {
	menu_page@ p = menu_page("Applicants. Offers are final, so no haggling them down a quarter at a time");
	for (uint i = 0; i < g_applicants.length(); i++) {
		applicant@ a = g_applicants[i];
		p.add(a.name + ", " + a.stars + " star " + staff_role_name(a.role) + ", asking "
			+ money(a.wage) + " an hour, " + plural(staff_rota_shift_count_of(a), "shift", "shifts") + " a week",
			ACT_STAFF_APPL_BASE + int(i));
	}
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ applicant_page(int index) {
	if (index < 0 or uint(index) >= g_applicants.length()) return applicants_page();
	applicant@ a = g_applicants[index];
	menu_page@ p = menu_page(a.name + ", " + a.stars + " star " + staff_role_name(a.role)
		+ ", asking " + money(a.wage) + " an hour, " + plural(staff_rota_shift_count_of(a), "shift", "shifts") + " a week");
	p.add("Offer their asking wage, " + money(a.wage), ACT_STAFF_HIRE_BASE + index);
	p.add("Offer " + money(a.wage - 25) + " an hour", ACT_STAFF_HIRE_BASE + 500 + index);
	p.add("Offer " + money(a.wage - 50) + " an hour", ACT_STAFF_HIRE_BASE + 1000 + index);
	p.add("Back", ACT_CLOSE);
	return p;
}

/* ---- policies, hours, music, rename ------------------------------------- */

menu_page@ policies_page() {
	menu_page@ p = menu_page("Policies");
	p.add("Coffee and the fountain: " + ((g_drinks_self_serve == 1) ? "self serve" : "employee serve")
		+ ", press Enter to switch", ACT_POLICY_DRINKS);
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ hours_page() {
	menu_page@ p = menu_page("Hours. You need at least one person employed to open around the clock");
	p.add(g_hours_24h ? "Open around the clock, press Enter to go back to seven to ten" : "Open seven in the morning to ten at night",
		ACT_HOURS_TOGGLE);
	if (staff_uncovered_nights() > 0) p.add("Nights with nobody on the rota, expect trouble", ACT_CLOSE);
	p.add("Back", ACT_CLOSE);
	return p;
}

string music_display_name(const string&in path) {
	string s = path;
	int cut = s.find_last("/");
	if (cut >= 0) s = s.substr(uint(cut) + 1);
	int dot = s.find_last(".");
	if (dot > 0) s = s.substr(0, uint(dot));
	s = s.replace("_", " ", true);
	s = s.replace("-", " ", true);
	return s;
}

string music_special_title(const string&in kind) {
	if (kind == "chase") return "Back Aisle Dash";
	if (kind == "fight") return "Closing Time Argument";
	return "something else";
}

/* What is playing, for the page title and the speakers. */
string music_now_text() {
	if (g_music_special.length() > 0) return music_special_title(g_music_special);
	if (!g_music_on) return "nothing, the music is off";
	if (g_music_now.length() > 0) return g_music_now;
	return g_music_tracks.length() > 0 ? music_display_name(g_music_tracks[uint(g_music_track)]) : "nothing yet";
}

menu_page@ music_page() {
	menu_page@ p = menu_page("The shop's speakers. The music is " + (g_music_on ? "on" : "off")
		+ ", playing " + music_now_text() + ". Volume " + g_music_volume
		+ " percent, subwoofers " + g_sub_volume + " percent");
	p.add(g_music_on ? "Switch the music off" : "Switch the music on", ACT_MUSIC_TOGGLE);
	p.add("Skip to the next track", ACT_MUSIC_NEXT);
	p.add("Back to the previous track", ACT_MUSIC_PREV);
	p.add("Look for new tracks, " + plural(int(g_music_tracks.length()), "track", "tracks") + " found", ACT_MUSIC_SCAN);
	p.add("Shuffle is " + (g_music_shuffle ? "on" : "off"), ACT_MUSIC_SHUFFLE);
	p.add("Volume up five percent", ACT_MUSIC_UP);
	p.add("Volume down five percent", ACT_MUSIC_DOWN);
	p.add("Subwoofers up ten percent", ACT_MUSIC_SUB_UP);
	p.add("Subwoofers down ten percent", ACT_MUSIC_SUB_DOWN);
	p.add("Back", ACT_CLOSE);
	return p;
}

menu_page@ rename_page() {
	menu_page@ p = menu_page("Renaming the store. This can only be done once, and only in your first week");
	p.add("Keep " + g_store_name, ACT_CLOSE);
	p.add("Rename it to " + g_store_name, ACT_RENAME_CONFIRM);
	p.add("Back", ACT_CLOSE);
	return p;
}

bool music_file_ok(const string&in f) {
	string lower = f.lower();
	return lower.ends_with(".mp3") or lower.ends_with(".ogg") or lower.ends_with(".wav")
		or lower.ends_with(".flac") or lower.ends_with(".m4a") or lower.ends_with(".wma");
}

/* Look for tracks in every music folder this shop knows about. The player's own
   folder is scanned first, so their tracks take the front of the playlist. */
void music_scan(bool quiet = false) {
	g_music_tracks.resize(0);
	array<string>@ folders = array<string>();
	folders.insert_last("sounds/music");
	folders.insert_last(ASSET_DIR + "/music");
	folders.insert_last("music");
	int folders_found = 0;
	for (uint f = 0; f < folders.length(); f++) {
		if (!directory_exists(folders[f])) continue;
		folders_found++;
		string[]@ files = glob(folders[f] + "/*");
		for (uint i = 0; i < files.length(); i++) {
			if (music_file_ok(files[i])) g_music_tracks.insert_last(files[i]);
		}
	}
	if (!quiet) {
		if (folders_found == 0) {
			say("There is no music folder yet. Put your own tracks in sounds slash music, or in music next to the game, and look again.", true);
			return;
		}
		say("Found " + plural(int(g_music_tracks.length()), "track", "tracks") + ". "
			+ (int(g_music_tracks.length()) > 0 ? "The first one is " + music_display_name(g_music_tracks[0]) + "." : ""), true);
	}
}

/* Percent to decibels. 100 percent is the recording as it came, 50 is about
   minus six, and silence is floored rather than infinite. */
float music_volume_db(int percent) {
	if (percent <= 0) return -60.0;
	double ratio = double(percent) / 100.0;
	return float(20.0 * (log(ratio) / log(10.0)));
}

float music_sub_db(int percent) {
	if (percent <= 0) return -60.0;
	double ratio = double(percent) / 100.0;
	return float(20.0 * (log(ratio) / log(10.0)));
}

/* Play track i through the shop's speakers. */
bool music_play_index(int i) {
	if (!g_music_on or g_music_tracks.length() == 0) return false;
	int n = int(g_music_tracks.length());
	while (i < 0) i += n;
	while (i >= n) i -= n;
	g_music_track = i;
	string path = g_music_tracks[uint(i)];
	if (!music_start(path, false)) {
		say("That track will not play: " + music_display_name(path) + ".", true);
		return false;
	}
	g_music_now = music_display_name(path);
	return true;
}

void music_play_next() {
	if (g_music_tracks.length() == 0) return;
	int n = int(g_music_tracks.length());
	int next = g_music_shuffle ? random(0, n - 1) : (g_music_track + 1);
	if (!g_music_on) { g_music_track = (next % n); return; }
	int tries = 0;
	while (tries < n and !music_play_index(next)) { next = (next + 1) % n; tries++; }
}

void music_play_prev() {
	if (g_music_tracks.length() == 0) return;
	int n = int(g_music_tracks.length());
	int prev = (g_music_track - 1);
	if (!g_music_on) { g_music_track = ((prev + n) % n); return; }
	int tries = 0;
	while (tries < n and !music_play_index(prev)) { prev = ((prev - 1) + n) % n; tries++; }
}

/* Bring the speakers into line with g_music_on. This has to be called whenever
   that flag changes underneath the player, and in particular when a game starts
   or a save is loaded: the speakers belong to the process, not to the store, so
   otherwise the last store's music keeps playing in a shop that has its music
   switched off, or a store that was left with music on sits in silence. */
void music_apply() {
	music_gain_db(music_volume_db(g_music_volume));
	music_sub_gain_db(music_sub_db(g_sub_volume));
	if (g_music_special.length() > 0) return;   /* a chase or a fight owns them */
	if (!g_music_on) { music_stop(); return; }
	if (g_music_tracks.length() == 0) music_scan(true);   /* silently: just the list */
	if (g_music_tracks.length() == 0) return;
	if (!music_playing()) music_play_index(g_music_track);
}

/* The chase and the fight take the speakers over, the way they do in the
   reference game: they play through the speakers even when the shop's own music
   is switched off, and when the trouble is over the speakers go back to whatever
   was playing before. */
void music_special_start(const string&in kind) {
	if (g_music_special == kind) return;
	if (g_music_special.length() == 0) {
		g_music_resume_track = g_music_track;
		g_music_was_on = g_music_on;
	}
	g_music_special = kind;
	music_gain_db(music_volume_db(g_music_volume));
	music_sub_gain_db(music_sub_db(g_sub_volume));
	string path = ASSET_DIR + "/music/" + ((kind == "chase") ? "chase_back_aisle.wav" : "fight_ruckus.wav");
	if (!music_start(path, true)) {
		/* No such recording: nothing to play, so do not pretend otherwise. */
		log_line("music", "no recording for the " + kind + " at " + path);
		g_music_special = "";
		return;
	}
	g_music_now = music_special_title(kind);
	log_line("music", kind + " music through the shop's speakers");
}

void music_special_end(const string&in kind) {
	if (g_music_special != kind) return;
	g_music_special = "";
	if (g_music_was_on and g_music_tracks.length() > 0) music_play_index(g_music_resume_track);
	else music_stop();
	log_line("music", "the " + kind + " is over, speakers back to " + music_now_text());
}

/* Once per frame: the playlist moves on when a track plays itself out, and the
   speakers come back up if something took them away (a load, a special that
   ended without a track to go back to, a dead slot). */
void music_tick() {
	if (g_music_special.length() > 0) return;
	if (!g_music_on) return;
	if (g_music_tracks.length() == 0) return;
	if (music_finished()) { music_play_next(); return; }
	if (!music_playing()) music_play_index(g_music_track);
}

/* A shoplifter making a run for the door, with the goods. */
bool music_thief_on_the_run() {
	for (uint i = 0; i < g_customers.length(); i++) {
		customer@ c = g_customers[i];
		if (@c is null or !c.shoplifter) continue;
		if (c.state == CUST_GONE or c.room != ROOM_SHOP) continue;
		if (c.swatted or c.ran) return true;
	}
	return false;
}

/* The chase and the fight own the speakers while they last, and hand them back
   afterwards. Both are read out of the world here rather than pushed in by
   trouble.nvgt, because this file is the last module included and nothing
   earlier can call into it. */
void music_trouble_tick() {
	if (g_fights.length() > 0) { music_special_start("fight"); return; }
	if (music_thief_on_the_run()) { music_special_start("chase"); return; }
	if (g_music_special == "fight") music_special_end("fight");
	else if (g_music_special == "chase") music_special_end("chase");
}

/* ==========================================================================
   8.  THE PHONE
   ========================================================================== */

menu_page@ phone_page() {
	menu_page@ p = menu_page("Your phone. The clock has stopped while you are here");
	p.add("Email, " + plural(int(g_emails.length()), "message", "messages"), ACT_PHONE_EMAIL);
	p.add("News", ACT_PHONE_NEWS);
	p.add("Reviews", ACT_PHONE_REVIEWS);
	/* The forecourt from wherever you are standing: a shop that sells fuel
	   needs to know its tank level away from the terminal. */
	p.add("The forecourt, " + fuel_tank_text(), ACT_PHONE_FUEL);
	/* The handset's own speech speed, for the same reason the terminal has one:
	   the order the player types into it is read back in its own voice. */
	p.add(chip_speed_line(CHIP_DEVICE_PHONE), ACT_SPEED_PHONE);
	p.add(chip_pitch_line(CHIP_DEVICE_PHONE), ACT_PITCH_PHONE);
	p.add("Put the phone away", ACT_CLOSE);
	return p;
}

string send_cap(const string&in s) {
	if (s.length() == 0) return s;
	return chip_upper(s.substr(0, 1)) + s.substr(1, s.length() - 1);
}

/* The page behind a machine's Speech speed: or Pitch: line. Enter on one of those
   lines opens this rather than stepping the setting where it stands: every
   setting the machine offers is listed, the one it is on now is named, and the
   line is read out by the machine as the cursor passes it. Picking one applies
   it, hears it in the machine's own voice and goes back to the home page with
   the cursor on the line that was changed. */
menu_page@ chip_setting_page(int device, bool pitch) {
	string who = (device == CHIP_DEVICE_PHONE) ? "the phone" : "the terminal";
	string name = pitch ? "Pitch" : "Speech speed";
	menu_page@ p = menu_page(name + " on " + who
		+ ". Enter keeps a setting, and it is saved with this store");
	string choices = pitch ? CHIP_PITCH_CHOICES : CHIP_SPEED_CHOICES;
	int base = pitch ? ACT_SPEECH_PITCH_CHOICE_BASE : ACT_SPEECH_SPEED_CHOICE_BASE;
	int current = pitch ? chip_profile_of(device).pitch_pct : chip_profile_of(device).speed_pct;
	for (int i = 0; i < chip_pct_choice_count(choices); i++) {
		int pct = chip_pct_choice(choices, i);
		string word = pitch ? chip_pitch_word(pct) : chip_speed_word(pct);
		string label = (word.length() > 0) ? send_cap(word) : ("" + pct);
		label += ", " + pct + " per cent of " + (pitch ? "its own pitch" : "the chip's own rate");
		if (pct == current) label += ", the setting now";
		p.add(label, base + i);
	}
	p.add("Back", ACT_BACK);
	return p;
}

/* One line of either page was chosen: put that setting on the machine, write it
   into this store's save, let the machine say what it now sounds like, and go
   back to its home page with the cursor on the line that changed. */
void chip_setting_choose(bool pitch, int index) {
	int device = machine_for_modal();
	if (device < 0) return;
	string choices = pitch ? CHIP_PITCH_CHOICES : CHIP_SPEED_CHOICES;
	int pct = chip_pct_choice(choices, index);
	if (pitch) chip_pitch_apply(device, pct);
	else chip_speed_apply(device, pct);
	chip_settings_save();
	string line = pitch
		? chip_pitch_preview_line(device, chip_profile_of(device).pitch_pct)
		: chip_speed_preview_line(device, chip_profile_of(device).speed_pct);
	machine_chip_line(device, line);
	g_menu.remove_last();
	menu_replace_current((device == CHIP_DEVICE_PHONE) ? phone_page() : computer_home_page(),
		pitch ? PITCH_LINE_PREFIX : SPEECH_LINE_PREFIX);
}

string phone_email_text() {
	if (g_emails.length() == 0) return "There is no email. Even the spam has given up.";
	string s = "Email, newest first. ";
	for (int i = int(g_emails.length()) - 1; i >= 0 and i >= int(g_emails.length()) - 8; i--) {
		s += g_emails[i] + ". ";
	}
	return s;
}

string phone_news_text() {
	if (g_news.length() == 0) return "Nothing in the news today.";
	string s = "The local news. ";
	for (int i = int(g_news.length()) - 1; i >= 0 and i >= int(g_news.length()) - 6; i--) s += g_news[i] + ". ";
	return s;
}

/* ==========================================================================
   9.  JAIL, AND WHAT PUTS YOU THERE
   ========================================================================= */

void jail_begin(int days) {
	if (g_in_jail) return;
	g_in_jail = true;
	g_jail_days_total = days;
	g_jail_days_served = 0;
	g_jail_blackout = false;
	g_jail_next_step = ticks() + 300;
	stop_all_speech();
	say("The cuffs go on, the car door shuts, and the cell door closes. "
		+ plural(days, "day", "days") + ". The shop keeps trading without you.", true);
	log_line("jail", "sentence of " + days + " days");
}

void jail_step() {
	if (!g_in_jail) return;
	if (ticks() < g_jail_next_step) return;
	g_jail_next_step = ticks() + 300;
	g_jail_days_served++;
	/* The staff keep the shop open as long as they can. Unpaid, they walk out,
	   the least capable first. */
	if (g_jail_days_served % 3 == 0 and g_staff.length() > 0) {
		int worst = 0;
		for (uint i = 1; i < g_staff.length(); i++) if (g_staff[i].stars < g_staff[worst].stars) worst = int(i);
		say(g_staff[worst].name + " has walked out. Nobody has been paid.", true);
		g_staff.remove_at(uint(worst));
		g_jail_lost_staff++;
	}
	/* Thieves help themselves once nobody is watching. */
	if (random(1, 100) <= 35) {
		int loss = random(2000, 9000);
		g_cash -= loss;
		if (g_cash < 0) g_cash = 0;
		g_jail_lost_cash += loss;
	}
	if (random(1, 100) <= 20) {
		int idx = random(0, int(g_catalog.length()) - 1);
		product@ p = product_at(idx);
		if (@p !is null) p.stock = 0;
	}
	if (g_jail_days_served >= g_jail_days_total) {
		g_in_jail = false;
		string s = "You are let out. " + plural(g_jail_days_served, "day", "days") + " have gone by. ";
		s += plural(g_jail_lost_staff, "member of staff", "members of staff") + " quit while you were in. ";
		s += money(g_jail_lost_cash) + " walked out of the till. ";
		if (g_jail_blackout) s += "The power was cut off while you were inside. ";
		s += "The till holds " + money(g_cash) + ".";
		say(s, true);
		log_line("jail", "released after " + g_jail_days_served + " days");
	}
}

/* Enough offences and you go to jail. */
void jail_check_offences() {
	if (g_in_jail or g_game_over) return;
	int offences = g_offence_count + g_turn_ins + g_false_alarms / 3;
	if (offences < 3) return;
	int days = random(3, 30);
	if (g_turn_ins >= 3) days = random(60, 120);
	/* Three months or more and the electricity company cuts the power. */
	if (days >= 90) g_jail_blackout = true;
	jail_begin(days);
}

/* ==========================================================================
   10.  SAVING AND LOADING
   ========================================================================= */

string slot_path(int slot) {
	if (slot < 1) slot = 1;
	if (slot > 15) slot = 15;
	return "saves/slot" + pad(slot, 2) + ".txt";
}

/* Put the two machines' own settings - their speech speed and their pitch -
   into the save they belong to, in place, without rewriting the rest of the
   file or rotating its backup. They are facts about this store's machines and
   not about this computer, so they live in the slot: loading another save puts
   that store's settings back on the machines. A store with no save on disk yet
   keeps the setting in memory and it is written by the next full save. */
void chip_settings_save() {
	if (!g_game_mode) return;
	string path = slot_path(g_slot);
	if (!file_exists(path)) return;
	string all = file_get_contents(path);
	if (all.length() == 0) return;
	for (int d = CHIP_DEVICE_COMPUTER; d <= CHIP_DEVICE_PHONE; d++) {
		all = config_text_with_value(all, chip_speed_save_key(d), "" + chip_profile_of(d).speed_pct, "");
		all = config_text_with_value(all, chip_pitch_save_key(d), "" + chip_profile_of(d).pitch_pct, "");
	}
	if (!file_put_contents(path, all)) log_line("save", "the machine speech settings could not be written to " + path);
}

void save_game(bool quiet = false) {
	if (!g_game_mode) return;
	string path = slot_path(g_slot);
	/* Keep the one before it, in case a save goes wrong. */
	if (file_exists(path)) {
		file old;
		if (old.open(path, "rb")) {
			string all = old.read();
			old.close();
			file bak;
			if (bak.open(path + ".bak", "wb")) { bak.write(all); bak.close(); }
		}
	}
	file f;
	if (!f.open(path, "wb")) {
		say("The save file could not be opened, so nothing was written.", true);
		return;
	}
	f.write("store_express_save=2\r\n");
	f.write("save_version=" + SAVE_VERSION + "\r\n");
	f.write("name=" + g_store_name + "\r\n");
	f.write("slot=" + g_slot + "\r\n");
	f.write("cash=" + g_cash + "\r\n");
	f.write("arrears=" + g_arrears + "\r\n");
	f.write("bill_stage=" + g_bill_stage + "\r\n");
	f.write("account_hold=" + (g_account_hold ? 1 : 0) + "\r\n");
	f.write("insurance=" + g_insurance_tier + "\r\n");
	f.write("declared_pct=" + g_declared_pct + "\r\n");
	f.write("under_declared=" + (g_under_declared ? 1 : 0) + "\r\n");
	f.write("takings=" + g_total_takings + "\r\n");
	f.write("tax_paid=" + g_tax_paid + "\r\n");
	f.write("wk_sales=" + g_wk_sales + "\r\n");
	f.write("wk_stock=" + g_wk_stock + "\r\n");
	f.write("wk_wages=" + g_wk_wages + "\r\n");
	f.write("wk_fines=" + g_wk_fines + "\r\n");
	f.write("wk_other=" + g_wk_other + "\r\n");
	f.write("wk_customers=" + g_wk_customers + "\r\n");
	f.write("reputation=" + num1(g_reputation) + "\r\n");
	f.write("unscanned=" + g_unscanned_sales + "\r\n");
	f.write("restricted=" + g_restricted_sales + "\r\n");
	f.write("id_scans=" + g_id_scans_logged + "\r\n");
	f.write("bad_inspections=" + g_bad_inspections + "\r\n");
	f.write("suspended=" + (g_licence_suspended ? 1 : 0) + "\r\n");
	f.write("suspension_weeks=" + g_suspension_weeks_left + "\r\n");
	f.write("board_fines=" + g_fines_from_board + "\r\n");
	f.write("false_alarms=" + g_false_alarms + "\r\n");
	f.write("turn_ins=" + g_turn_ins + "\r\n");
	f.write("police_fines=" + g_fines_owed + "\r\n");
	f.write("drinks_self_serve=" + g_drinks_self_serve + "\r\n");
	f.write("hours_24h=" + (g_hours_24h ? 1 : 0) + "\r\n");
	f.write("music_on=" + (g_music_on ? 1 : 0) + "\r\n");
	f.write("music_vol=" + g_music_volume + "\r\n");
	f.write("sub_vol=" + g_sub_volume + "\r\n");
	f.write("renamed=" + (g_renamed ? 1 : 0) + "\r\n");
	/* The machines' own speech, speed and pitch, which belong to this store. */
	for (int d = CHIP_DEVICE_COMPUTER; d <= CHIP_DEVICE_PHONE; d++) {
		f.write(chip_speed_save_key(d) + "=" + chip_profile_of(d).speed_pct + "\r\n");
		f.write(chip_pitch_save_key(d) + "=" + chip_profile_of(d).pitch_pct + "\r\n");
	}
	f.write("game_over=" + (g_game_over ? 1 : 0) + "\r\n");
	/* Which machines in this store have been set up, one line per device. */
	f.write(hardware_save_lines());
	f.write("clock=" + g_current_minute + "," + g_current_hour + "," + g_current_day_of_week
		+ "," + g_current_week + "," + g_current_day + "\r\n");
	f.write("player=" + g_player_room + "," + num1(g_px) + "," + num1(g_py) + "," + num1(g_facing) + "\r\n");
	for (uint i = 0; i < g_catalog.length(); i++) {
		f.write("prod=" + i + "," + g_catalog[i].stock + "," + g_catalog[i].price + "," + g_catalog[i].cost + "\r\n");
	}
	for (uint i = 0; i < g_draft_qty.length(); i++) {
		if (g_draft_qty[i] <= 0) continue;
		f.write("draft=" + i + "," + g_draft_qty[i] + "\r\n");
	}
	if (g_backroom_qty.length() == g_catalog.length()) {
		for (uint i = 0; i < g_backroom_qty.length(); i++) {
			if (g_backroom_qty[i] <= 0) continue;
			f.write("backroom=" + i + "," + g_backroom_qty[i] + "\r\n");
		}
	}
	/* The tank under the forecourt and the sign above it belong to this store,
	   like the machines' speech: one line, litres, price, cost, and any tanker
	   load already paid for. */
	f.write("fuel=" + g_fuel_litres + "," + g_fuel_price + "," + g_fuel_cost + ","
		+ g_fuel_order_litres + "," + g_fuel_order_day + "\r\n");
	for (uint i = 0; i < g_orders.length(); i++) {
		order_rec@ o = g_orders[i];
		f.write("order=" + o.arrive_day + "," + o.total + "," + o.ordered_day + "\r\n");
		for (uint j = 0; j < o.qty.length(); j++) {
			if (o.qty[j] <= 0) continue;
			f.write("orderline=" + i + "," + j + "," + o.qty[j] + "\r\n");
		}
	}
	for (uint i = 0; i < g_loans.length(); i++) {
		loan@ l = g_loans[i];
		f.write("loan=" + l.principal + "," + l.remaining + "," + l.weekly + "," + l.weeks_left
			+ "," + l.rate_pct + "," + (l.emergency ? 1 : 0) + "\r\n");
	}
	for (uint i = 0; i < g_staff.length(); i++) {
		worker@ w = g_staff[i];
		string rota = "";
		for (uint d = 0; d < w.rota.length(); d++) rota += ((d > 0) ? ":" : "") + w.rota[d];
		f.write("staff=" + w.name + "," + w.role + "," + w.stars + "," + w.wage + "," + w.satisfaction
			+ "," + (w.dishonest ? 1 : 0) + "," + (w.crooked ? 1 : 0) + "," + rota + "\r\n");
	}
	for (uint i = 0; i < g_reviews.length(); i++) {
		f.write("review=" + g_reviews[i].stars + "," + g_reviews[i].day + "\r\n");
	}
	/* What the regulars remember about this shop is part of this shop. Names and
	   scores rather than sentences, because the sentence is written fresh from
	   the score when they next walk in. */
	for (uint i = 0; i < g_regulars.length(); i++) {
		f.write("regular=" + g_regulars[i].name + "," + g_regulars[i].score + ","
			+ g_regulars[i].day + "," + g_regulars[i].visits + ","
			+ g_regulars[i].kind + "," + g_regulars[i].flavour + ","
			+ (g_regulars[i].remembered ? 1 : 0) + "\r\n");
	}
	for (uint i = 0; i < FACE_COUNT + 1; i++) { /* placeholder so the format is obvious */ break; }
	f.close();
	log_line("save", "saved to " + path);
	if (!quiet) say("Saved into slot " + g_slot + ".", true);
}

string save_get(const string&in key, const string&in fallback) {
	file f;
	if (!f.open(slot_path(g_slot), "rb")) return fallback;
	string all = f.read();
	f.close();
	string[]@ lines = all.split("\n");
	for (uint i = 0; i < lines.length(); i++) {
		string ln = lines[i].trim_whitespace();
		int eq = ln.find_first("=");
		if (eq < 0) continue;
		if (ln.substr(0, eq) != key) continue;
		return ln.substr(eq + 1).trim_whitespace();
	}
	return fallback;
}

int save_get_int(const string&in key, int fallback) {
	string v = save_get(key, "");
	if (v.length() == 0) return fallback;
	return parse_int(v);
}

void load_game_from(int slot) {
	g_slot = slot;
	if (!file_exists(slot_path(slot))) { say("That slot is empty.", true); return; }
	int sv = save_get_int("save_version", 0);
	if (sv == 0) {
		log_line("save", "save version not found, treating as legacy save");
	} else if (sv != SAVE_VERSION) {
		log_line("save", "save version " + sv + " vs current " + SAVE_VERSION);
	}
	g_store_name = save_get("name", "Store Express");
	g_cash = save_get_int("cash", 250000);
	g_arrears = save_get_int("arrears", 0);
	g_bill_stage = save_get_int("bill_stage", 0);
	g_account_hold = save_get_int("account_hold", 0) == 1;
	g_insurance_tier = save_get_int("insurance", INS_BASIC);
	g_declared_pct = save_get_int("declared_pct", 100);
	g_under_declared = save_get_int("under_declared", 0) == 1;
	g_total_takings = save_get_int("takings", 0);
	g_tax_paid = save_get_int("tax_paid", 0);
	g_wk_sales = save_get_int("wk_sales", 0);
	g_wk_stock = save_get_int("wk_stock", 0);
	g_wk_wages = save_get_int("wk_wages", 0);
	g_wk_fines = save_get_int("wk_fines", 0);
	g_wk_other = save_get_int("wk_other", 0);
	g_wk_customers = save_get_int("wk_customers", 0);
	g_reputation = parse_double(save_get("reputation", "3.0"));
	g_unscanned_sales = save_get_int("unscanned", 0);
	g_restricted_sales = save_get_int("restricted", 0);
	g_id_scans_logged = save_get_int("id_scans", 0);
	g_bad_inspections = save_get_int("bad_inspections", 0);
	g_licence_suspended = save_get_int("suspended", 0) == 1;
	g_suspension_weeks_left = save_get_int("suspension_weeks", 0);
	g_fines_from_board = save_get_int("board_fines", 0);
	g_false_alarms = save_get_int("false_alarms", 0);
	g_turn_ins = save_get_int("turn_ins", 0);
	g_fines_owed = save_get_int("police_fines", 0);
	g_drinks_self_serve = save_get_int("drinks_self_serve", 1);
	g_hours_24h = save_get_int("hours_24h", 0) == 1;
	g_music_on = save_get_int("music_on", 0) == 1;
	g_music_volume = save_get_int("music_vol", 100);
	g_sub_volume = save_get_int("sub_vol", 0);
	g_renamed = save_get_int("renamed", 0) == 1;
	g_game_over = save_get_int("game_over", 0) == 1;
	/* The hardware: a terminal that was never set up reads back as false, which
	   is also what a save written before the chips existed reads back as. */
	is_computer_initialized = save_get_int(HW_SAVE_KEY_COMPUTER, 0) == 1;
	is_phone_initialized    = save_get_int(HW_SAVE_KEY_PHONE, 0) == 1;
	/* The machines' own speech settings come back with the store. A save written
	   before they lived here reads back at the defaults. */
	for (int d = CHIP_DEVICE_COMPUTER; d <= CHIP_DEVICE_PHONE; d++) {
		chip_speed_apply(d, save_get_int(chip_speed_save_key(d), CHIP_SPEED_DEFAULT));
		chip_pitch_apply(d, save_get_int(chip_pitch_save_key(d), CHIP_PITCH_NORMAL));
	}

	string clock = save_get("clock", "0,7,0,1,1");
	string[]@ cb = clock.split(",");
	if (cb.length() >= 5) {
		g_current_minute = uint(parse_int(cb[0]));
		g_current_hour = uint(parse_int(cb[1]));
		g_current_day_of_week = uint(parse_int(cb[2]));
		g_current_week = uint(parse_int(cb[3]));
		g_current_day = uint(parse_int(cb[4]));
	}
	string pl = save_get("player", "");
	string[]@ pb = pl.split(",");
	if (pb.length() >= 4) {
		int room = parse_int(pb[0]);
		if (room >= 0 and room < ROOM_COUNT) g_player_room = room;
		g_px = float(parse_double(pb[1]));
		g_py = float(parse_double(pb[2]));
		g_facing = parse_double(pb[3]);
	}

	/* Products, orders, loans and staff are read back from the whole file. */
	file f;
	if (!f.open(slot_path(slot), "rb")) return;
	string all = f.read();
	f.close();
	string[]@ lines = all.split("\n");
	g_orders.resize(0);
	g_loans.resize(0);
	g_staff.resize(0);
	g_reviews.resize(0);
	g_regulars.resize(0);
	g_draft_qty.resize(g_catalog.length());
	for (uint i = 0; i < g_draft_qty.length(); i++) g_draft_qty[i] = 0;
	/* A save written before the fuel lived here reads back at the shop's own
	   defaults, and no pump is running in a store that was not open. */
	g_fuel_litres = FUEL_TANK_START;
	g_fuel_price = FUEL_PRICE_START;
	g_fuel_cost = FUEL_COST_START;
	g_fuel_order_litres = 0;
	g_fuel_order_day = 0;
	fuel_init();
	for (uint i = 0; i < lines.length(); i++) {
		string ln = lines[i].trim_whitespace();
		int eq = ln.find_first("=");
		if (eq < 0) continue;
		string key = ln.substr(0, eq);
		string val = ln.substr(eq + 1).trim_whitespace();
		string[]@ parts = val.split(",");
		if (key == "prod" and parts.length() >= 4) {
			int idx = parse_int(parts[0]);
			product@ p = product_at(idx);
			if (@p !is null) {
				p.stock = parse_int(parts[1]);
				p.price = parse_int(parts[2]);
				p.cost = parse_int(parts[3]);
				/* Put right anything that could not have happened. */
				if (p.stock > p.capacity) p.stock = p.capacity;
				if (p.stock < 0) p.stock = 0;
				if (p.price < 1) p.price = 1;
				if (p.cost < 1) p.cost = 1;
			}
		} else if (key == "regular" and parts.length() >= 3) {
			regular_memory@ r = regular_memory(parts[0], parse_int(parts[1]), parse_int(parts[2]));
			/* A save written before the town existed carries a name, a score
			   and a day and nothing else, and reads back as somebody who has
			   been in once. */
			if (parts.length() >= 4) r.visits = parse_int(parts[3]);
			if (parts.length() >= 5) r.kind = parse_int(parts[4]);
			if (parts.length() >= 6) r.flavour = parse_int(parts[5]);
			if (parts.length() >= 7) r.remembered = (parse_int(parts[6]) != 0);
			if (r.visits < 1) r.visits = 1;
			if (r.kind < 0 or r.kind >= ARCH_COUNT) r.kind = ARCH_REGULAR;
			g_regulars.insert_last(r);
		} else if (key == "draft" and parts.length() >= 2) {
			int idx = parse_int(parts[0]);
			if (idx >= 0 and uint(idx) < g_draft_qty.length()) g_draft_qty[idx] = parse_int(parts[1]);
		} else if (key == "backroom" and parts.length() >= 2) {
			if (g_backroom_qty.length() != g_catalog.length()) {
				g_backroom_qty.resize(g_catalog.length());
				for (uint i = 0; i < g_backroom_qty.length(); i++) g_backroom_qty[i] = 0;
			}
			int idx = parse_int(parts[0]);
			if (idx >= 0 and uint(idx) < g_backroom_qty.length()) g_backroom_qty[idx] = parse_int(parts[1]);
		} else if (key == "fuel" and parts.length() >= 5) {
			g_fuel_litres = parse_int(parts[0]);
			g_fuel_price = parse_int(parts[1]);
			g_fuel_cost = parse_int(parts[2]);
			g_fuel_order_litres = parse_int(parts[3]);
			g_fuel_order_day = parse_int(parts[4]);
			/* Put right anything that could not have happened. */
			if (g_fuel_litres < 0) g_fuel_litres = 0;
			if (g_fuel_litres > FUEL_TANK_CAPACITY) g_fuel_litres = FUEL_TANK_CAPACITY;
			if (g_fuel_price < FUEL_PRICE_FLOOR) g_fuel_price = FUEL_PRICE_FLOOR;
			if (g_fuel_cost < FUEL_COST_FLOOR) g_fuel_cost = FUEL_COST_FLOOR;
			if (g_fuel_order_litres < 0) g_fuel_order_litres = 0;
			if (g_fuel_order_day < 0) g_fuel_order_day = 0;
		} else if (key == "order" and parts.length() >= 3) {
			order_rec@ o = order_rec(parse_int(parts[0]), TRUCK_MINUTE, parse_int(parts[1]),
				parse_int(parts[2]), int(g_current_week));
			o.qty.resize(g_catalog.length());
			for (uint q = 0; q < o.qty.length(); q++) o.qty[q] = 0;
			g_orders.insert_last(o);
		} else if (key == "orderline" and parts.length() >= 3) {
			int oi = parse_int(parts[0]);
			int pi = parse_int(parts[1]);
			if (oi >= 0 and uint(oi) < g_orders.length() and pi >= 0 and uint(pi) < g_catalog.length()) {
				g_orders[oi].qty[pi] = parse_int(parts[2]);
			}
		} else if (key == "loan" and parts.length() >= 6) {
			loan@ l = loan(parse_int(parts[0]), parse_int(parts[2]), parse_int(parts[3]), parse_int(parts[4]), parse_int(parts[5]) == 1);
			l.remaining = parse_int(parts[1]);
			g_loans.insert_last(l);
		} else if (key == "staff" and parts.length() >= 8) {
			worker@ w = worker(parts[0], parse_int(parts[1]), parse_int(parts[2]), parse_int(parts[3]), parse_int(parts[4]));
			w.dishonest = parse_int(parts[5]) == 1;
			w.crooked = parse_int(parts[6]) == 1;
			string[]@ rb = parts[7].split(":");
			w.rota.resize(0);
			for (uint d = 0; d < rb.length(); d++) w.rota.insert_last(parse_int(rb[d]));
			g_staff.insert_last(w);
		} else if (key == "review" and parts.length() >= 2) {
			g_reviews.insert_last(review("a customer", "It is a shop. It sold me things.",
				parse_int(parts[0]), parse_int(parts[1])));
		}
	}

	g_in_jail = false;
	people_init_keep_reputation();
	board_schedule_inspection();
	rooms_refresh_audibility();
	g_game_mode = true;
	g_modal = MODAL_NONE;
	g_menu.resize(0);
	/* The speakers follow the store we just loaded, not the one we came from. */
	music_apply();
	say("Loaded " + g_store_name + ", slot " + slot + ". It is " + clock_full_text()
		+ ", the till holds " + money(g_cash) + ", and your reputation is "
		+ int(g_reputation + 0.5) + " stars.", true);
	log_line("save", "loaded slot " + slot);
}

/* Reloading must not wipe the reputation we just read out of the file. */
void people_init_keep_reputation() {
	g_customers.resize(0);
	g_queue.resize(0);
}

void delete_slot(int slot) {
	string path = slot_path(slot);
	if (!file_exists(path)) { say("That slot is empty.", true); return; }
	file_delete(path);
	if (file_exists(path + ".bak")) file_delete(path + ".bak");
	say("Slot " + slot + " has been deleted, and its backup with it.", true);
}

string slot_summary(int slot) {
	int keep = g_slot;
	g_slot = slot;
	if (!file_exists(slot_path(slot))) { g_slot = keep; return "Slot " + slot + ", empty"; }
	string name = save_get("name", "a store");
	int day = save_get_int("clock_day", 0);
	int cash = save_get_int("cash", 0);
	g_slot = keep;
	return "Slot " + slot + ", " + name + ", " + money(cash);
}

/* ==========================================================================
   11.  NEW GAME
   ========================================================================= */

void new_game_in(int slot) {
	g_slot = slot;
	g_store_name = "Store Express";
	g_renamed = false;
	hardware_reset_for_new_game();   /* no machine here has ever been set up */
	/* A new store's machines start at the default speed and pitch, not at
	   whatever the last store the player loaded was left at. */
	for (int d = CHIP_DEVICE_COMPUTER; d <= CHIP_DEVICE_PHONE; d++) {
		chip_speed_apply(d, CHIP_SPEED_DEFAULT);
		chip_pitch_apply(d, CHIP_PITCH_NORMAL);
	}
	g_cash = cfg_int("starting_cash_cents", 250000);
	g_arrears = 0;
	g_bill_stage = BILL_STAGE_OK;
	g_account_hold = false;
	g_emergency_loan_taken = false;
	g_insurance_tier = INS_BASIC;
	g_insurance_weeks_unpaid = 0;
	g_pending_insurance_claim = 0;
	g_declared_pct = 100;
	g_under_declared = false;
	g_total_takings = 0;
	g_tax_paid = 0;
	g_fines_paid = 0;
	g_wk_sales = 0; g_wk_stock = 0; g_wk_wages = 0; g_wk_fines = 0; g_wk_other = 0; g_wk_customers = 0;
	g_game_over = false;
	g_game_over_reason = "";
	g_licence_suspended = false;
	g_suspension_weeks_left = 0;
	g_bad_inspections = 0;
	g_fines_from_board = 0;
	g_unscanned_sales = 0; g_restricted_sales = 0; g_id_scans_logged = 0;
	g_in_jail = false;
	g_hours_24h = false;
	g_drinks_self_serve = 1;
	g_music_on = false;
	g_music_volume = 100;
	g_sub_volume = 0;
	g_current_minute = 0;
	g_current_hour = 7;
	g_current_day_of_week = MONDAY;
	g_current_week = 1;
	g_current_day = 1;
	g_last_day_seen = 1;
	g_clock_accum = 0.0;

	/* The world and the catalogue are built once, at startup. Starting a new
	   store resets their state rather than rebuilding them: rooms_init()
	   registers the ambient beacons, and calling it twice would leave two copies
	   of every hum playing on top of each other. */
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		p.stock = p.capacity;
		p.price = p.fair;
		p.cost = p.opening_cost;
		p.sold_since_delivery = 0;
		p.revenue_since_delivery = 0;
	}
	g_draft_qty.resize(0);
	g_orders.resize(0);
	g_mess.resize(0);
	/* The previous owner left the tank part full and the sign at the going
	   rate. Nothing is running on the forecourt. */
	g_fuel_litres = FUEL_TANK_START;
	g_fuel_price = FUEL_PRICE_START;
	g_fuel_cost = FUEL_COST_START;
	g_fuel_order_litres = 0;
	g_fuel_order_day = 0;
	fuel_init();
	staff_init();
	people_init();
	trouble_init();
	g_emails.resize(0);
	g_news.resize(0);
	g_player_room = ROOM_SHOP;
	g_px = 4.5; g_py = 2.5; g_facing = 0.0;
	rooms_camera_drop();
	rooms_refresh_audibility();
	board_schedule_inspection();
	email_add("Marguerite Dell", "Welcome to the shop, and the rules that matter");
	email_add("Ridgeline Wholesale", "Your account is open, order by Saturday");
	g_game_mode = true;
	g_modal = MODAL_NONE;
	g_menu.resize(0);
	/* A new store always starts with its music off, so anything playing from a
	   store you just left has to stop. */
	music_apply();
	email_add("The bank", "Bill day is every Friday at six in the morning");
	email_add("The alcohol board", "Identification scans are audited monthly");
	say("New store, slot " + slot + ". You are " + g_store_name + ", on Main Street, "
		+ "with " + money(g_cash) + " in the till and nobody employed. It is Monday, day one, "
		+ "seven in the morning, and the shop is open. Press F1 for the controls, or B to scan the room.", true);
	log_line("game", "new game in slot " + slot);
}

/* ==========================================================================
   12.  THE CLOCK AND THE DAY CYCLE
   ========================================================================== */

void world_new_day() {
	g_current_day++;
	g_current_day_of_week++;
	if (g_current_day_of_week > 6) {
		g_current_day_of_week = 0;
		g_current_week++;
		shop_market_week();
	}
	staff_accrue_daily_wages();
	staff_maybe_request();
	staff_request_deadlines();
	people_reputation_update();
	/* A fortnight of not coming in is enough for the shop to forget a face it
	   has only seen once or twice, unless there is something worth keeping. */
	people_regular_forget(int(g_current_day));
	shop_check_deliveries();
	/* An open position brings five more applicants every Monday. */
	if (int(g_current_day_of_week) == MONDAY) staff_applicant_morning();
	log_line("clock", "day " + g_current_day + ", " + day_name(int(g_current_day_of_week))
		+ ", week " + g_current_week);
}

void world_hour_struck() {
	/* Six in the morning: applicants, and the truck. */
	if (int(g_current_hour) == 6 and int(g_current_minute) == 0) {
		if (int(g_current_day_of_week) == FRIDAY) {
			money_bill_day();
			money_start_new_week();
			money_audit_check();
		}
	}
	if (int(g_current_hour) == 6 and int(g_current_minute) == 30) shop_check_deliveries();
	/* Closing time announcements. */
	if (!g_hours_24h and till_usable()) {
		int to_close = clock_minutes_to_close();
		if (to_close == 30 or to_close == 15 or to_close == 5) {
			/* The bell over the shop's doors rings to call the time, in the doorway
			   rather than all over the room, and cut to the ring: the recording is a
			   twenty two second bell and a doorway is the first moment of it. */
			sfx_at(ROOM_SHOP, 31.5, 24.5, 0.0, A("chime.ogg"), -6.0, DOOR_CHIME_CUT_MS);
			/* The announcement plays through the same speakers, so the music gets
			   out of its way first. */
			music_duck(7000);
			say("The shop's announcement speakers ring a ding, and call the time. The shop closes in "
				+ plural(to_close, "minute", "minutes") + ".", true);
		}
	}
	board_check_inspection();
	g_day_ms_accum = 0;
}

void clock_advance_one_minute() {
	g_current_minute++;
	if (int(g_current_minute) >= 60) {
		g_current_minute = 0;
		g_current_hour++;
	}
	if (int(g_current_hour) >= 24) {
		g_current_hour = 0;
		world_new_day();
	}
	shop_check_deliveries();
	mess_tick_minute();
	staff_janitor_minute_tick();
	staff_restocker_tick();
	trouble_tick_minute();
	if (int(g_current_minute) == 0) world_hour_struck();
	if (g_in_jail) jail_step();
}

void clock_tick(double dt_ms) {
	if (clock_is_paused()) return;
	if (g_game_over) return;
	if (g_in_jail) { g_jail_next_step = ticks(); jail_step(); return; }
	if (g_clock_fast_forward) {
		/* The jail fast forward runs the same clock, only much faster. */
		g_clock_accum += dt_ms * 40.0;
	} else {
		g_clock_accum += dt_ms * g_minutes_per_second;
	}
	while (g_clock_accum >= 1000.0) {
		g_clock_accum -= 1000.0;
		clock_advance_one_minute();
		if (g_game_over) return;
	}
}

void clock_announce() {
	music_duck(6000);      /* anything read out through the shop's speakers */
	string s = "It is " + clock_full_text() + ". ";
	s += clock_shop_open() ? "The shop is open. " : "The shop is shut. ";
	if (!g_hours_24h) {
		int to_close = clock_minutes_to_close();
		if (to_close >= 0) s += "It closes in " + duration_text(to_close) + ". ";
	}
	if (clock_is_paused()) s += "The clock is stopped while this screen is open. ";
	else s += "The clock is running. ";
	s += "The till holds " + money(g_cash) + ". ";
	if (g_licence_suspended) s += "Your licence is suspended for another " + g_suspension_weeks_left + " weeks. ";
	if (!g_power_on) s += "The power is out. ";
	say(s, true);
}

/* ==========================================================================
   13.  INTERACTION
   ========================================================================== */

thing@ thing_find_shim() { return thing_under_player(); }

void open_sleep() {
	if (g_game_over) return;
	g_modal = MODAL_SLEEP;
	g_menu.resize(0);
	menu_page@ p = menu_page("Your bed. Sleeping moves the clock to six in the morning, and saves the game");
	p.add("Sleep until six in the morning", ACT_SLEEP);
	p.add("Not yet", ACT_CLOSE);
	menu_push(p);
}

void do_sleep() {
	stop_all_speech();
	sfx_ui(A("door_close.ogg"), -12.0);
	/* If the shop is still open, it keeps trading while you snore, and with
	   nobody on the till customers get fed up and leave. */
	if (clock_shop_open() and !staff_any_on_duty(ROLE_CASHIER)) {
		say("You sleep with the shop still open, and nobody on the till. Customers get fed up and walk out.", true);
		int lost = random(2, 8);
		for (int i = 0; i < lost; i++) people_spawn();
		for (uint i = 0; i < g_customers.length(); i++) {
			customer@ c = g_customers[i];
			if (@c is null) continue;
			c.mood -= 5;
		}
	}
	/* Advance to six in the morning. */
	int guard = 0;
	while (guard < 2000) {
		guard++;
		if (int(g_current_hour) == 6 and int(g_current_minute) == 0) break;
		clock_advance_one_minute();
	}
	save_game(true);
	say("You sleep, and wake at six in the morning. " + clock_full_text() + ". The shop is saved.", true);
	mechanics_close_modal();
}

void mechanics_interact() {
	if (g_game_over) { say(g_game_over_reason + " Escape opens the menu, where you can start again or load a save.", true); return; }
	if (g_in_jail) { say("You are in a cell, not behind the counter.", true); return; }

	/* Standing in a mess is reason enough on its own, and it comes before the
	   nothing-here reply, because a mop is not a fixture. */
	mess@ spill = mess_at(g_player_room, g_px, g_py);
	if (@spill !is null) {
		string what = mess_word(spill.kind);
		mess_remove_at(g_player_room, g_px, g_py);
		sfx_ui(A("squish.mp3"), -12.0);
		say("You clean up " + what + ". The floor is dry there again.", true);
		return;
	}

	thing@ t = thing_under_player();
	if (@t is null) { say("There is nothing here to use.", true); return; }

	switch (t.kind) {
		case IK_REGISTER:      open_register(); return;
		case IK_QUEUE_TILL:    open_register(); return;
		case IK_COMPUTER:      open_computer(); return;
		case IK_BACKDOOR:
			say("The office back door. It is bolted from the inside, and the alley beyond it is empty.", true);
			return;
		case IK_BED:           open_sleep(); return;
		case IK_SHELF_FACE:
			say(shop_report_face(t.ref) + " Press Enter again to see the lines on this face.", true);
			/* A second press opens the face's lines. */
			return;
		case IK_COFFEE:
		{
			worker@ srv = staff_on_duty(ROLE_SERVER);
			string who = (@srv !is null) ? (srv.name + " is on the rota here, pouring the cups.")
				: ((g_drinks_self_serve == 1) ? "Customers pour their own." : "Employee serve, and nobody is on the rota for it, so you pour them at the till.");
			say("The coffee station. " + (t.damaged ? "It has been knocked over and needs a repair. " : "") + who, true);
			return;
		}
		case IK_FOUNTAIN:
		{
			worker@ srv = staff_on_duty(ROLE_SERVER);
			string who = (@srv !is null) ? (srv.name + " is on the rota here, pouring the fountain drinks.")
				: ((g_drinks_self_serve == 1) ? "Self serve, so customers help themselves."
					: "Employee serve, and nobody is on the rota for it, so the drinks wait for you at the till.");
			say("The soda fountain. " + (t.damaged ? "It has been knocked over and needs a repair. " : "") + who, true);
			return;
		}
		case IK_FRIDGE_CASE:
			say("The refrigerated display cases hum along the north wall. " + trouble_damaged_text(), true);
			return;
		case IK_FROZEN_CASE:
			say("The frozen food cases. " + trouble_damaged_text(), true);
			return;
		case IK_COOLER_DOOR:
			say("The walk in cooler door. The door is in the middle of the refrigerated cases, which is how you know where you are.", true);
			return;
		case IK_FREEZER_DOOR:
			say("The walk in freezer door.", true);
			return;
		case IK_COOLER_RACK: case IK_FREEZER_RACK:
			say(t.label + ", holding stock for the shelves.", true);
			return;
		case IK_COUNTER:
			if (t.ref == 1) {
				say("The cigarette and vape cabinet. " + shop_face_stock_pct(FACE_COUNTER)
					+ " percent stocked. Every sale of these needs an identification scan.", true);
				return;
			}
			say("The counter, where the till sits.", true);
			return;
		case IK_SAFE:     say("The office safe. It holds the takings you have banked, " + money(g_bank) + ".", true); return;
		case IK_TV:       say("The television is " + (g_tv_on ? "on" : "off") + ".", true); return;
		case IK_KITCHEN_FRIDGE: say("The kitchen fridge hums.", true); return;
		case IK_SPEAKERS:
			say("The ceiling speakers. The music is " + (g_music_on ? "on" : "off")
				+ ", playing " + music_now_text() + ", at " + g_music_volume
				+ " percent, with the subwoofers at " + g_sub_volume + " percent. "
				+ "They are only heard in here and through the wall, so walk into the office or the cooler and the shop's music stays behind.", true);
			return;
		case IK_PUMP:
		{
			string s = "Unleaded, " + money(g_fuel_price) + " a litre, paid for inside at the till before any of it moves. ";
			if (g_fuel_litres <= 0) {
				s += "The tank under the forecourt is dry, so the pumps have nothing to give. "
					+ "Order a load on the manager terminal and it comes with the truck on Monday morning.";
			} else {
				s += "The tank holds " + plural(g_fuel_litres, "litre", "litres") + ". ";
			}
			int running = fuel_pumps_running();
			if (running > 0) s += plural(running, "pump is", "pumps are") + " running out here now.";
			else if (g_fuel_litres > 0) s += "No pump is running. A driver comes in and pays, and then you hear the nozzle start out here.";
			say(s, true);
			return;
		}
		case IK_AIRPUMP:
			say("The air and water pump. Free, like every forecourt's air pump, and it works.", true);
			return;
		case IK_ROAD:
			if (g_fuel_litres > 0) {
				say("The road. Traffic goes by, and the cars that want fuel pull up by the pumps and come in to pay at the till.", true);
			} else {
				say("The road. Traffic goes by, and nobody stops: with the tank dry there is nothing to sell them.", true);
			}
			return;
	}
	say("There is nothing to do with " + t.label + ".", true);
}

/* ==========================================================================
   14.  THE OPTIONS AND ISSUE PAGES, AND THE PAUSE MENU
   ========================================================================== */

void open_issues() {
	g_modal = MODAL_ISSUES;
	g_menu.resize(0);
	menu_page@ p = menu_page("Issue reporter. This writes your exact position to the diagnostics log");
	p.add("Audio cues do not line up", ACT_ISSUE_AUDIO);
	p.add("The clock does not look right", ACT_ISSUE_CLOCK);
	p.add("A room or doorway behaves wrongly", ACT_ISSUE_MAP);
	p.add("Something else", ACT_ISSUE_OTHER);
	p.add("Cancel", ACT_CLOSE);
	menu_push(p);
}

void file_issue(const string&in category) {
	file f;
	if (f.open(ISSUE_FILE, "ab")) {
		f.write("[" + stamp(ticks()) + "] " + category
			+ " | room: " + room_name(g_player_room)
			+ " | at: " + num1(g_px) + "," + num1(g_py)
			+ " | clock: " + clock_full_text()
			+ " | cash: " + money(g_cash)
			+ " | customers: " + people_in_shop()
			+ " | reputation: " + num1(g_reputation) + "\r\n");
		f.close();
	}
	say("Reported: " + category + ", from " + room_name(g_player_room) + " at "
		+ num1(g_px) + " east, " + num1(g_py) + " north. It is in the issue log.", true);
	mechanics_close_modal();
}

void open_pause() {
	save_game(true);
	g_modal = MODAL_PAUSE;
	g_menu.resize(0);
	menu_page@ p = menu_page("Paused. The clock has stopped, and customers' patience with it");
	p.add("Resume trading", ACT_PAUSE_RESUME);
	p.add("Save the game", ACT_PAUSE_SAVE);
	p.add("Options", ACT_PAUSE_OPTIONS);
	p.add("Save and return to the main menu", ACT_PAUSE_MENU);
	p.add("Save and quit", ACT_PAUSE_QUIT);
	menu_push(p);
}

menu_page@ pause_options_page() {
	menu_page@ p = menu_page("Options. The same choices the main menu offers");
	p.add("Voice: " + (g_sr_preferred ? "the screen reader when one is available" : "this computer's own voices"),
		ACT_PAUSE_TTS);
	p.add("Diagnostics are " + (g_diag_enabled ? "on" : "off"), ACT_PAUSE_DIAG);
	p.add("Sound output: " + audio_device_summary(), ACT_PAUSE_SOUND);
	p.add("Back", ACT_BACK);
	return p;
}

/* The device list, drawn from audio.nvgt's own list so this page and the main
   menu's page are the same list with the same numbers. */
menu_page@ sound_output_page() {
	audio_devices_refresh();
	menu_page@ p = menu_page("Sound output. Which speakers or headphones the game plays through");
	for (int i = 0; i < audio_device_menu_items(); i++) {
		p.add(audio_device_menu_label(i), ACT_SOUND_DEVICE_BASE + i);
	}
	return p;
}

/* ==========================================================================
   15.  DISPATCH
   ========================================================================== */

void menu_dispatch(int action, const string&in label) {
	/* ---- dynamic families first ---------------------------------------- */
	if (action == ACT_SERVE_FETCH) { sale_open(); sale_page_build(); return; }
	if (action >= ACT_SPEECH_SPEED_CHOICE_BASE and action < ACT_SPEECH_SPEED_CHOICE_BASE + 20) {
		chip_setting_choose(false, action - ACT_SPEECH_SPEED_CHOICE_BASE);
		return;
	}
	if (action >= ACT_SPEECH_PITCH_CHOICE_BASE and action < ACT_SPEECH_PITCH_CHOICE_BASE + 20) {
		chip_setting_choose(true, action - ACT_SPEECH_PITCH_CHOICE_BASE);
		return;
	}
	if (action >= ACT_SLOT_BASE and action < ACT_SLOT_BASE + 20) {
		int slot = action - ACT_SLOT_BASE;
		if (g_game_mode) { save_game(); return; }
		if (file_exists(slot_path(slot))) load_game_from(slot);
		else new_game_in(slot);
		return;
	}
	if (action >= ACT_FUEL_ORDER_BASE and action < ACT_FUEL_ORDER_BASE + 10) {
		int raw = action - ACT_FUEL_ORDER_BASE;
		int litres = 200;
		if (raw == 1) litres = 500;
		if (raw >= 2) litres = 1000;
		fuel_order(litres);
		/* Back to the restock page, rebuilt so its tank line is the truth. The
		   confirmation has already been said, so nothing else is spoken here. */
		if (g_menu.length() > 1) {
			g_menu.remove_last();
			menu_replace_current(order_page(), "Fuel for the forecourt");
		}
		return;
	}
	if (action >= ACT_STAFF_HIRE_BASE and action < ACT_STAFF_HIRE_BASE + 1500) {
		int raw = action - ACT_STAFF_HIRE_BASE;
		int idx = raw % 500;
		int level = raw / 500;       /* 0 asking, 1 minus 25, 2 minus 50 */
		if (uint(idx) >= g_applicants.length()) return;
		int offer = g_applicants[idx].wage - level * 25;
		staff_hire(idx, offer);
		menu_back();
		return;
	}
	if (action >= ACT_STAFF_EMP_BASE and action < ACT_STAFF_EMP_BASE + 400) {
		menu_push(employee_page(action - ACT_STAFF_EMP_BASE)); return;
	}
	if (action >= ACT_STAFF_FIRE_BASE and action < ACT_STAFF_FIRE_BASE + 400) {
		staff_fire(action - ACT_STAFF_FIRE_BASE); menu_back(); menu_back(); return;
	}
	if (action >= ACT_STAFF_RAISE_BASE and action < ACT_STAFF_RAISE_BASE + 400) {
		staff_give_raise(action - ACT_STAFF_RAISE_BASE, 100); menu_back(); return;
	}
	if (action >= ACT_STAFF_CUT_BASE and action < ACT_STAFF_CUT_BASE + 400) {
		staff_cut_wage(action - ACT_STAFF_CUT_BASE, 100); menu_back(); return;
	}
	if (action >= ACT_STAFF_ROTA_M_BASE and action < ACT_STAFF_ROTA_M_BASE + 400) {
		staff_set_rota_shift(action - ACT_STAFF_ROTA_M_BASE, SHIFT_MORNING); menu_back(); return;
	}
	if (action >= ACT_STAFF_ROTA_E_BASE and action < ACT_STAFF_ROTA_E_BASE + 400) {
		staff_set_rota_shift(action - ACT_STAFF_ROTA_E_BASE, SHIFT_EVENING); menu_back(); return;
	}
	if (action >= ACT_STAFF_ROTA_N_BASE and action < ACT_STAFF_ROTA_N_BASE + 400) {
		staff_set_rota_shift(action - ACT_STAFF_ROTA_N_BASE, SHIFT_NIGHT); menu_back(); return;
	}
	if (action >= ACT_STAFF_GRANT_BASE and action < ACT_STAFF_GRANT_BASE + 400) {
		staff_grant_request(action - ACT_STAFF_GRANT_BASE); menu_back(); return;
	}
	if (action >= ACT_STAFF_REFUSE_BASE and action < ACT_STAFF_REFUSE_BASE + 400) {
		staff_refuse_request(action - ACT_STAFF_REFUSE_BASE); menu_back(); return;
	}
	if (action >= ACT_STAFF_APPL_BASE and action < ACT_STAFF_APPL_BASE + 400) {
		menu_push(applicant_page(action - ACT_STAFF_APPL_BASE)); return;
	}
	if (action >= ACT_STAFF_OPEN_BASE and action < ACT_STAFF_CLOSE_BASE) {
		staff_open_position(action - ACT_STAFF_OPEN_BASE); menu_back(); return;
	}
	if (action >= ACT_STAFF_CLOSE_BASE and action < ACT_STAFF_CLOSE_BASE + 400) {
		staff_close_position(action - ACT_STAFF_CLOSE_BASE); menu_back(); return;
	}
	if (action >= ACT_ORDER_CANCEL_BASE and action < ACT_ORDER_CANCEL_BASE + 100) {
		shop_cancel_order(action - ACT_ORDER_CANCEL_BASE); menu_back(); return;
	}
	if (action >= ACT_ORDER_FACE_BASE and action < ACT_ORDER_FACE_BASE + 200) {
		shop_order_fill_face(action - ACT_ORDER_FACE_BASE); menu_back(); menu_back(); return;
	}
	if (action >= ACT_LOAN_TAKE_BASE and action < ACT_LOAN_TAKE_BASE + 3) {
		int which = action - ACT_LOAN_TAKE_BASE;
		int amount = (which == 0) ? 100000 : ((which == 1) ? 250000 : 500000);
		money_take_loan(amount); menu_back(); return;
	}
	if (action >= ACT_LOAN_PAYOFF_BASE and action < ACT_LOAN_PAYOFF_BASE + 100) {
		money_pay_off_loan(action - ACT_LOAN_PAYOFF_BASE); menu_back(); return;
	}
	if (action >= ACT_DECLARE_BASE and action < ACT_DECLARE_BASE + 200) {
		money_declare(action - ACT_DECLARE_BASE); menu_back(); return;
	}
	if (action >= ACT_PRICE_PROD_BASE and action < ACT_PRICE_PROD_BASE + 2000) {
		int idx = action - ACT_PRICE_PROD_BASE;
		g_price_product = idx;
		menu_push(product_price_page(idx));
		return;
	}
	if (action >= ACT_PRICE_FACE_BASE and action < ACT_PRICE_FACE_BASE + 200) {
		int face = action - ACT_PRICE_FACE_BASE;
		if (face == 100) face = FACE_COUNTER;
		g_price_face = face;
		if (g_modal == MODAL_COMPUTER and g_menu.length() > 0) {}
		menu_push(face_price_page(face));
		return;
	}
	/* The device list of the pause menu's Options page. */
	if (action >= ACT_SOUND_DEVICE_BASE and action < ACT_SOUND_DEVICE_BASE + 200) {
		int choice = audio_device_menu_choice(action - ACT_SOUND_DEVICE_BASE);
		if (choice == OUT_DEVICE_BACK) { menu_back(); return; }
		if (choice == out_device_trial_index()) {
			/* The same line twice: the player heard it, so it stays. */
			audio_device_confirm();
			device_test_sweep_stop();
			say("Kept. The game plays through " + audio_device_label(choice) + " now, and will again next time.", true);
			return;
		}
		if (!audio_device_try(choice)) {
			say("The machine would not open " + audio_device_label(choice) + ", so nothing has changed.", true);
			return;
		}
		device_test_sweep_begin();
		string trying = "Trying " + audio_device_label(choice) + ". Listen: a blip on the left, then one on the right. ";
		trying += "Press enter again to keep it, or escape and the sound goes back to ";
		trying += (g_out_device_home < 0) ? "the system default" : audio_device_label(g_out_device_home);
		trying += ". Nothing is written until you keep it.";
		say(trying, true);
		return;
	}

	/* Order review line removal uses the same index space as products. */
	if (action >= 22000 and action < 22000 + 2000) {
		int idx = action - 22000;
		if (idx >= 0 and uint(idx) < g_draft_qty.length()) g_draft_qty[idx] = 0;
		say("Taken off the order.", true);
		menu_back();
		return;
	}

	switch (action) {
	case ACT_CLOSE:
	case ACT_COMP_LOGOFF: {
		int dev = machine_for_modal();
		if (dev >= 0) { machine_chip_cut(); machine_power_sound(dev, false); }
		mechanics_close_modal();
		say(g_modal == MODAL_NONE ? "Closed." : "", true);
		return;
	}
	case ACT_PAUSE_RESUME: mechanics_close_modal(); say("Back to the shop.", true); return;
	case ACT_PAUSE_SAVE:   save_game(); menu_back(); return;
	case ACT_PAUSE_OPTIONS: menu_push(pause_options_page()); return;
	case ACT_PAUSE_TTS:
		g_sr_preferred = !g_sr_preferred;
		say(g_sr_preferred ? "Using the screen reader when one is available."
			: "Using the built in voice instead.", true);
		menu_back();
		return;
	case ACT_PAUSE_DIAG:
		g_diag_enabled = !g_diag_enabled;
		say("Diagnostics are " + (g_diag_enabled ? "on" : "off") + ".", true);
		menu_back();
		return;
	case ACT_PAUSE_SOUND:
		out_device_trial_begin();
		menu_push(sound_output_page());
		return;
	/* The machine's own speech speed and pitch, on the machine's own screen.
	   Enter on one of those lines opens the page of settings behind it rather
	   than stepping the setting where it stands. */
	case ACT_SPEED_TERM:  menu_push(chip_setting_page(CHIP_DEVICE_COMPUTER, false)); return;
	case ACT_PITCH_TERM:  menu_push(chip_setting_page(CHIP_DEVICE_COMPUTER, true));  return;
	case ACT_SPEED_PHONE: menu_push(chip_setting_page(CHIP_DEVICE_PHONE, false)); return;
	case ACT_PITCH_PHONE: menu_push(chip_setting_page(CHIP_DEVICE_PHONE, true));  return;
	case ACT_BACK: menu_back(); return;
		case ACT_PAUSE_MENU:
			save_game(true);
			mechanics_close_modal();
			g_game_mode = false;
			say("Saved. Back to the main menu.", true);
			return;
		case ACT_PAUSE_QUIT:   save_game(true); request_quit = true; return;

		/* ---- serving ---------------------------------------------------- */
case ACT_SERVE_FETCH:      sale_open(); sale_page_build(); return;
		case ACT_SERVE_SCAN_ONE:   sale_scan_one(); return;
		case ACT_SERVE_SCAN_REST:  sale_scan_rest(); return;
		case ACT_SERVE_ASK_ID:     sale_ask_id(); return;
		case ACT_SERVE_REFUSE_REST: sale_refuse_restricted(); return;
		case ACT_SERVE_CARD:       sale_take_card(); return;
		case ACT_SERVE_CASH_EXACT: sale_take_cash(g_sale_total); return;
		case ACT_SERVE_CASH_ROUND: sale_take_cash(((g_sale_total / 500) + 1) * 500); return;
		case ACT_SERVE_CASH_WALLET: sale_take_short_payment(); return;
		case ACT_SERVE_SELL_COVERS: sale_sell_covers(); sale_page_build(); return;
		case ACT_SERVE_FREE_DRINK:  sale_free_drink(); sale_page_build(); return;
		case ACT_SERVE_REFUSE_SALE: sale_refuse_sale(); return;
		case ACT_SERVE_COUNT_CHANGE: sale_count_change(); return;
		case ACT_SERVE_WALK_AWAY:  sale_walk_away(); return;

		/* ---- computer --------------------------------------------------- */
		case ACT_COMP_RESTOCK:  menu_push(order_page()); return;
		case ACT_COMP_DAMAGE:   menu_push(damage_page()); return;
		case ACT_COMP_BILLS:    menu_push(bills_page()); return;
		case ACT_COMP_REPORTS:  menu_push(reports_page()); return;
		case ACT_COMP_PRICES:   menu_push(prices_home_page()); return;
		case ACT_COMP_STAFF:    menu_push(staff_page()); return;
		case ACT_COMP_POLICIES: menu_push(policies_page()); return;
		case ACT_COMP_HOURS:    menu_push(hours_page()); return;
		case ACT_COMP_MUSIC:    menu_push(music_page()); return;
		case ACT_COMP_RENAME:   menu_push(rename_page()); return;
		case ACT_COMP_LAW:      say(trouble_police_record_text() + " " + money_bills_text(), true); return;

		case ACT_ORDER_FILL_ALL: shop_order_fill_all(); menu_back(); return;
		case ACT_ORDER_FUEL:     menu_push(fuel_order_page()); return;
		case ACT_ORDER_REVIEW:   menu_push(order_review_page()); return;
		case ACT_ORDER_PLACE:    shop_order_place(); menu_back(); return;
		case ACT_ORDER_CLEAR:    shop_order_clear(); menu_back(); return;
		case ACT_ORDER_PLACED:   menu_push(order_placed_page()); return;
		case ACT_ORDER_FACE_BASE: menu_push(order_aisle_page()); return;

		case ACT_REPAIR_ALL:  trouble_repair_all(); menu_back(); return;
		case ACT_CLAIM_STOCK:
			if (g_last_thief_loss <= 0) { say("There is nothing to claim for.", true); return; }
			money_claim_stock(g_last_thief_loss, "a shoplifter");
			g_last_thief_loss = 0;
			menu_back();
			return;

		case ACT_BANK_PAY_ARREARS:
			if (g_arrears <= 0) { say("You do not owe anything.", true); return; }
			if (!money_can_afford(g_arrears)) { say("That would take " + money(g_arrears) + " and the till holds " + money(g_cash) + ".", true); return; }
			g_cash -= g_arrears;
			g_arrears = 0;
			g_bill_stage = BILL_STAGE_OK;
			g_account_hold = false;
			sfx_ui(A("register.ogg"), -8.0);
			say("You paid everything you owed. The wholesaler has taken your account off hold, and the bank loves you again.", true);
			return;
		case ACT_BANK_PNL_WEEK:  say(money_pnl_text() + " " + money_status_text(), true); return;
		case ACT_BANK_PNL_LAST:  say(money_pnl_text(), true); return;
		case ACT_BANK_BILL_LIST: say(money_bills_text(), true); return;
		case ACT_BANK_INSURANCE: menu_push(insurance_page()); return;
		case ACT_BANK_LOANS:     menu_push(loans_page()); return;
		case ACT_BANK_DECLARE:   menu_push(declare_page()); return;
		case ACT_INS_NONE:  money_set_insurance(INS_NONE);  menu_back(); return;
		case ACT_INS_BASIC: money_set_insurance(INS_BASIC); menu_back(); return;
		case ACT_INS_HALF:  money_set_insurance(INS_BASIC_HALF); menu_back(); return;
		case ACT_INS_ALL:   money_set_insurance(INS_BASIC_ALL); menu_back(); return;
		case ACT_EMERGENCY_LOAN: money_take_emergency_loan(); menu_back(); return;

		case ACT_REP_TILL:      say("The till holds " + money(g_cash) + ".", true); return;
		case ACT_REP_SALES:     say(shop_report_sales(), true); return;
		case ACT_REP_LEVELS:    say(shop_report_levels(), true); return;
		case ACT_REP_EMPTY:     say(shop_report_out_of_stock(), true); return;
		case ACT_REP_SPEND:     say(shop_report_spend(), true); return;
		case ACT_REP_BESTWORST: say(shop_report_best_worst(), true); return;
		case ACT_REP_MARKET:    say(shop_market_text(), true); return;
		case ACT_REP_AISLES:    menu_push(aisles_page()); return;
		case ACT_REP_FUEL:      say(shop_fuel_text(), true); return;

		case ACT_PRICE_UP5:    if (g_price_product >= 0) { product@ p = product_at(g_price_product); if (@p !is null) shop_price_set(g_price_product, p.price + 5); } return;
		case ACT_PRICE_UP25:   if (g_price_product >= 0) { product@ p = product_at(g_price_product); if (@p !is null) shop_price_set(g_price_product, p.price + 25); } return;
		case ACT_PRICE_DOWN5:  if (g_price_product >= 0) { product@ p = product_at(g_price_product); if (@p !is null) shop_price_set(g_price_product, p.price - 5); } return;
		case ACT_PRICE_DOWN25: if (g_price_product >= 0) { product@ p = product_at(g_price_product); if (@p !is null) shop_price_set(g_price_product, p.price - 25); } return;
		case ACT_PRICE_FAIR:   shop_price_to_fair(g_price_product); return;
		case ACT_PRICE_FACE_UP5:    shop_price_face(g_price_face, 5); return;
		case ACT_PRICE_FACE_UP10:   shop_price_face(g_price_face, 10); return;
		case ACT_PRICE_FACE_DOWN5:  shop_price_face(g_price_face, -5); return;
		case ACT_PRICE_FACE_DOWN10: shop_price_face(g_price_face, -10); return;		case ACT_PRICE_FACE_FAIR:  shop_price_face_to_fair(g_price_face); return;
		case ACT_PRICE_ALL_FAIR:    shop_price_all_to_fair(); menu_back(); return;
		case ACT_PRICE_FUEL:        menu_push(fuel_price_page()); return;
		case ACT_FUEL_PRICE_UP5:    g_fuel_price += 5;   fuel_price_tell(label); return;
		case ACT_FUEL_PRICE_UP25:   g_fuel_price += 25;  fuel_price_tell(label); return;
		case ACT_FUEL_PRICE_DOWN5:  g_fuel_price -= 5;   fuel_price_tell(label); return;
		case ACT_FUEL_PRICE_DOWN25: g_fuel_price -= 25;  fuel_price_tell(label); return;
		case ACT_FUEL_PRICE_FAIR:   g_fuel_price = fuel_fair_price(); fuel_price_tell(label); return;

		case ACT_STAFF_POSITIONS:  menu_push(positions_page()); return;
		case ACT_STAFF_LIST:       menu_push(staff_list_page()); return;
		case ACT_STAFF_APPLICANTS: menu_push(applicants_page()); return;

		case ACT_POLICY_DRINKS:
			g_drinks_self_serve = (g_drinks_self_serve == 1) ? 0 : 1;
			say(g_drinks_self_serve == 1 ? "Self serve. Customers pour their own, which is faster, easier to walk out without paying, and every so often somebody spills."
				: "Employee serve. Somebody has to pour every cup, and the drink is paid for before it is poured.", true);
			return;
		case ACT_HOURS_TOGGLE:
			if (!g_hours_24h and staff_count() == 0) {
				say("You cannot open around the clock with nobody employed, because you cannot stay awake forever. Hire somebody first.", true);
				return;
			}
			g_hours_24h = !g_hours_24h;
			say(g_hours_24h ? "The shop is open around the clock now." : "The shop is open from seven in the morning to ten at night again.", true);
			return;
		case ACT_MUSIC_TOGGLE:
			g_music_on = !g_music_on;
			music_apply();
			say(g_music_on ? ("The shop's music is on. " + music_now_text() + " is playing through the ceiling speakers.")
				: "The shop's music is off.", true);
			return;
		case ACT_MUSIC_SCAN:   music_scan(); return;
		case ACT_MUSIC_SHUFFLE: g_music_shuffle = !g_music_shuffle; say(g_music_shuffle ? "Shuffle on." : "Playing in order.", true); return;
		case ACT_MUSIC_NEXT:   music_play_next(); say("Playing " + music_now_text() + ".", true); return;
		case ACT_MUSIC_PREV:   music_play_prev(); say("Playing " + music_now_text() + ".", true); return;
		case ACT_MUSIC_UP:     g_music_volume += 5; if (g_music_volume > 200) g_music_volume = 200; music_apply(); say("Volume " + g_music_volume + " percent.", true); return;
		case ACT_MUSIC_DOWN:   g_music_volume -= 5; if (g_music_volume < 0) g_music_volume = 0; music_apply(); say("Volume " + g_music_volume + " percent.", true); return;
		case ACT_MUSIC_SUB_UP: g_sub_volume += 10; if (g_sub_volume > 300) g_sub_volume = 300; music_apply(); say("Subwoofers " + g_sub_volume + " percent. The shelves are starting to rattle.", true); return;
		case ACT_MUSIC_SUB_DOWN: g_sub_volume -= 10; if (g_sub_volume < 0) g_sub_volume = 0; music_apply(); say("Subwoofers " + g_sub_volume + " percent.", true); return;
		case ACT_RENAME:
			g_store_name = "Shop McShopface";
			g_renamed = true;
			say("The store is now called " + g_store_name + ". Choose wisely. That is permanent.", true);
			menu_back();
			return;
		case ACT_RENAME_CONFIRM:
			g_store_name = "Shop McShopface";
			g_renamed = true;
			say("The store is now called " + g_store_name + ".", true);
			menu_back();
			return;

		case ACT_SLEEP: do_sleep(); return;

		case ACT_PHONE_EMAIL:   say(phone_email_text(), true); return;
		case ACT_PHONE_NEWS:    say(phone_news_text(), true); return;
		case ACT_PHONE_REVIEWS: say(people_reviews_text(), true); return;
		case ACT_PHONE_FUEL:    say(shop_fuel_text(), true); return;

		case ACT_ISSUE_AUDIO: file_issue("audio cues do not line up"); return;
		case ACT_ISSUE_CLOCK: file_issue("the clock does not look right"); return;
		case ACT_ISSUE_MAP:   file_issue("a room or doorway behaves wrongly"); return;
		case ACT_ISSUE_OTHER: file_issue("something else"); return;
	}
	say("That is not available.", true);
}


void menu_move(int delta) {
	if (g_menu.length() == 0) return;
	menu_page@ p = g_menu[g_menu.length() - 1];
	if (p.count() == 0) return;
	p.index += delta;
	if (p.index < 0) p.index = p.count() - 1;
	if (p.index >= p.count()) p.index = 0;
	sfx_tick();
	menu_speak_current(false);
}

void menu_jump(int delta) {
	if (g_menu.length() == 0) return;
	menu_page@ p = g_menu[g_menu.length() - 1];
	if (p.count() == 0) return;
	p.index += delta;
	if (p.index < 0) p.index = 0;
	if (p.index >= p.count()) p.index = p.count() - 1;
	sfx_tick();
	menu_speak_current(false);
}

void menu_select() {
	if (g_menu.length() == 0) { mechanics_close_modal(); return; }
	menu_page@ p = g_menu[g_menu.length() - 1];
	if (p.count() == 0) { menu_back(); return; }
	int a = p.actions[p.index];
	g_last_action = a;
	diag("menu", "select action " + a + " in " + p.title);
	/* Somebody is using a machine: what the action has to report is the machine's
	   to say, so it is caught here and handed to the chip of whichever machine is
	   on screen instead of being read out in the player's voice. The device is
	   remembered rather than looked up afterwards, because an action is allowed
	   to close the screen it was taken from (logging off does exactly that) and
	   the machine still has to give its answer. */
	int machine = machine_for_modal();
	if (machine >= 0) {
		/* Enter is a move too: the line being read stops and the machine answers
		   at once, rather than the answer waiting behind the label. */
		machine_chip_cut();
		terminal_capture_begin();
	}
	menu_dispatch(a, p.labels[p.index]);
	if (machine >= 0) machine_action_spoken(machine);
}

/* ==========================================================================
   16.  SPAWNING CUSTOMERS
   ========================================================================== */

uint g_next_spawn_at = 0;

void people_spawn_tick(uint now) {
	if (!g_game_mode or g_game_over or g_in_jail) return;
	if (!clock_shop_open()) return;
	if (g_modal == MODAL_SLEEP) return;
	if (now < g_next_spawn_at) return;
	double per_hour = people_arrivals_per_hour();
	int ms = int(3600000.0 / ((per_hour > 0.2) ? per_hour : 0.2));
	if (ms < 4000) ms = 4000;
	g_next_spawn_at = now + uint(ms);
	people_spawn();
	/* A cashier on shift means the till is covered even when you are not there. */
	worker@ cashier = staff_on_duty(ROLE_CASHIER);
	if (@cashier !is null and random(1, 100) <= 60) staff_cashier_crooked_sale(cashier);
}

/* ==========================================================================
   17.  THE FRAME AND MINUTE HOOKS
   ========================================================================== */

/* How long a cashier takes over one customer, from their star rating. A five
   star is twice the speed of a one star, which is what makes the rating worth
   the wage. One place decides it, so nothing else re-derives it. */
int cashier_serve_interval_ms(worker@ w) {
	int stars = (@w is null or w.stars <= 0) ? 1 : w.stars;
	return 2400 / stars;
}

/* A customer at the till with a cashier on duty: if their drink was not
   already poured at the station, a drink server on shift pours it now; on
   employee serve with no server on duty, a cashier will not leave the till to
   work the fountain, so the customer goes without their cup. Returns what the
   drink adds to the bill if it was not already counted in people_basket_total. */
int cashier_handle_drink(customer@ c) {
	if (@c is null or !c.wants_drink) return 0;
	int kind = (c.drink_kind == DRINK_COFFEE) ? DRINK_COFFEE : DRINK_FOUNTAIN;
	if (c.drink_poured) {
		if (c.drink_cost > 0) people_drink_count_add(c);
		return 0;    /* already inside people_basket_total(c) */
	}
	if (drink_station_damaged(kind)) {
		c.wants_drink = false;
		c.mood -= 2;
		people_event(c, EV_BARE);
		return 0;
	}
	worker@ srv = staff_on_duty(ROLE_SERVER);
	if (@srv !is null) {
		int price = staff_server_pour(srv, kind, c.name);
		c.drink_poured = true;
		c.drink_cost = price;
		c.drink_poured_by = srv.name;
		if (price > 0) people_drink_count_add(c);
		return price;
	}
	if (g_drinks_self_serve == 1) {
		int price = drink_price_cents(kind);
		c.drink_poured = true;
		c.drink_cost = price;
		people_drink_count_add(c);
		return price;
	}
	/* Employee serve, and no drink server on shift: the cashier stays on the
	   register and cannot pour it. */
	c.mood -= 2;
	people_event(c, EV_DRINK_REFUSED);
	people_karen_note(c, 1);
	people_drunk_no_drink(c);
	return 0;
}

/* A cashier works the till from the same spot you do. Better cashiers are
   faster and miscount change less often. */
void cashier_serve_one(worker@ w) {
	customer@ c = people_queue_head();
	if (@c is null) return;
	if (!staff_worker_on_now(w)) return;
	/* A driver is served the same way, with the litres instead of a basket:
	   money first, tank second, pump when they reach the car. */
	if (c.fuel_litres > 0) {
		int give = c.fuel_litres;
		if (give > g_fuel_litres) give = g_fuel_litres;
		if (give <= 0) {
			say(w.name + " tells " + c.name + " the tank is dry, so there is no fuel to put in the car.", true);
			c.mood -= 3;
			c.state = CUST_LEAVING;
			for (int i = int(g_queue.length()) - 1; i >= 0; i--) if (g_queue[i] is c) g_queue.remove_at(uint(i));
			return;
		}
		int extra_drink = cashier_handle_drink(c);
		int fuel_total = give * g_fuel_price + (c.drink_poured ? c.drink_cost : 0);
		if (extra_drink > 0) fuel_total = give * g_fuel_price + extra_drink;
		board_note_sale(false, true);
		fuel_take(give);
		money_earn(fuel_total);
		g_wk_customers++;
		w.served++;
		c.fuel_litres = give;
		c.served = true;
		c.bought = true;
		c.spent = fuel_total;
		c.state = CUST_LEAVING;
		for (int i = int(g_queue.length()) - 1; i >= 0; i--) if (g_queue[i] is c) g_queue.remove_at(uint(i));
		people_event(c, EV_SERVED);
		sfx_ui(A("register.ogg"), -12.0);
		diag("staff", w.name + " sold " + give + " litres to " + c.name + " for " + money(fuel_total));
		return;
	}
	cashier_handle_drink(c);
	int total = people_basket_total(c);
	/* They ring it through. Crooked ones skip the ID scan, which the board will
	   find in the till log. */
	bool restricted = people_basket_has_restricted(c);
	if (restricted) {
		if (w.crooked) { board_note_sale(true, false); }
		else { log_id_scan("a restricted line"); board_note_sale(true, true); w.ids_checked++; }
	}
	board_note_sale(false, true);
	/* Take the stock off the shelves. */
	for (uint i = 0; i < c.basket.length(); i++) shop_sell(c.basket[i], c.basket_qty[i]);
	money_earn(total);
	g_wk_customers++;
	w.served++;
	/* A five star cashier rarely mistcounts. */
	int mistake_chance = (6 - w.stars) * 4;
	if (random(1, 100) <= mistake_chance) {
		w.change_mistakes++;
		if (random(1, 100) <= 30) {
			int short_by = random(50, 400);
			people_note_short_change(c, short_by);
		}
	}
	c.served = true;
	c.bought = true;
	c.spent = total;
	c.state = CUST_LEAVING;
	for (int i = int(g_queue.length()) - 1; i >= 0; i--) if (g_queue[i] is c) g_queue.remove_at(uint(i));
	people_event(c, EV_SERVED);
	if (!restricted and random(1, 100) <= 20) people_event(c, EV_ID_ASKED);
	sfx_ui(A("register.ogg"), -12.0);
	diag("staff", w.name + " served " + c.name + " for " + money(total));
}

/* ==========================================================================
   17b.  A CASHIER WITH NOTHING TO DO
   --------------------------------------------------------------------------
   A till with somebody behind it is not the same shop as a till on its own, and
   most of the difference is the talking. A cashier chats with whoever is near
   the counter when there is no queue, which customers like, and which is the
   part of a shop a player hears and remembers.
   ========================================================================== */

/* One slot in the voice pool per member of staff, handed out the first time
   they speak and kept for the session, so the same cashier sounds like the same
   person all evening. Nothing here is saved: it is the voice of this session. */
class staff_voice_rec {
	string name;
	int    slot;
	staff_voice_rec(const string&in n, int s) { name = n; slot = s; }
}

array<staff_voice_rec@> g_staff_voice_recs;

int staff_voice_for(worker@ w) {
	/* -1 means "nobody's voice": a member of staff with no worker behind them,
	   or a shop with no voices left to hand out, speaks in the player's own
	   channel rather than borrowing somebody else's voice. */
	if (@w is null) return -1;
	for (uint i = 0; i < g_staff_voice_recs.length(); i++) {
		if (g_staff_voice_recs[i].name == w.name) return g_staff_voice_recs[i].slot;
	}
	int slot = voice_pool_assign();
	g_staff_voice_recs.insert_last(staff_voice_rec(w.name, slot));
	return slot;
}

/* A staff voice that has been dropped: the member of staff is given another one,
   so a dead server does not leave the cashier sounding like the player. */
void staff_reassign_lost_voice(int dead) {
	if (dead < 0) return;
	for (uint i = 0; i < g_staff_voice_recs.length(); i++) {
		if (g_staff_voice_recs[i].slot != dead) continue;
		g_staff_voice_recs[i].slot = voice_pool_assign();
		log_line("staff", g_staff_voice_recs[i].name + " moved off a voice that was lost");
	}
}

uint g_next_cashier_chatter = 0;

/* Somebody near the till who is not queueing, not leaving and not mid-sale. */
customer@ cashier_chatter_customer(worker@ w) {
	customer@ best = null;
	float bestd = 999.0;
	for (uint i = 0; i < g_customers.length(); i++) {
		customer@ c = g_customers[i];
		if (@c is null or c.room != ROOM_SHOP) continue;
		if (c.state == CUST_GONE or c.state == CUST_LEAVING) continue;
		if (c.state == CUST_QUEUEING or c.state == CUST_SERVING) continue;
		if (@g_sale_customer is c) continue;
		float d = dist2(c.x, c.y, 7.5, 2.5);
		if (d < bestd) { bestd = d; @best = c; }
	}
	return best;
}

void cashier_chatter_tick(uint now) {
	if (!g_game_mode or g_game_over or g_in_jail) return;
	if (now < g_next_cashier_chatter) return;
	g_next_cashier_chatter = now + uint(random(25000, 70000));
	worker@ w = staff_on_duty(ROLE_CASHIER);
	if (@w is null) return;
	if (people_queue_length() > 0) return;      // nobody chats with a queue waiting
	customer@ c = cashier_chatter_customer(w);
	if (@c is null) return;
	int slot = staff_voice_for(w);
	voice_use(slot);
	say(w.name + ", behind the counter, says: " + staff_chatter_open(w, c), true);
	voice_clear();
	voice_use(c.voice);
	say(c.name + staff_chatter_reply(c), false);
	voice_clear();
	/* Being talked to is the thing customers like about a staffed shop. */
	c.mood += 1;
	people_event(c, EV_CHATTED);
	w.satisfaction += 1;
	if (w.satisfaction > SAT_MAX) w.satisfaction = SAT_MAX;
	log_line("staff", w.name + " chatted with " + c.name + " at the till");
}

/* The camera can fly around on its own for the demo style listening, but here it
   is the player's; this hook just keeps the ambience flag honest. */
void rooms_camera_update_tick(uint now) {
	if (!g_cam_up) return;
	/* Nothing to do each frame: rooms_listener() reads the camera state. Kept as
	   a hook so future camera work has an obvious home. */
}

/* ==========================================================================
   18.  THE FRAME
   ========================================================================== */

void mechanics_update(double dt_ms) {
	uint now = ticks();
	if (!g_game_mode) return;

	if (g_in_jail) { jail_step(); return; }

	clock_tick(dt_ms);
	if (g_game_over) return;

	/* The hardware in the building. The chips write their lines a slice of a
	   frame at a time, and a device that is installing itself keeps its own time
	   here, so a long chip line or a hardware routine cannot stall the shop.
	   This sits above the g_game_over and jail returns on purpose: a chip that
	   is already talking finishes its sentence. */
	hardware_tick();
	if (g_hw_need_save) { g_hw_need_save = false; save_game(true); }
	if (g_hw_need_open) { g_hw_need_open = false; open_computer(); }
	if (g_hw_need_open_phone) { g_hw_need_open_phone = false; open_phone(); }

	/* A voice that has been dropped takes the people who had it with it. They are
	   handed other voices of their own rather than falling into whoever is next
	   to them, which is the difference between a shop and a chorus. audio.nvgt
	   cannot see the people (it is included first), so it leaves the lost slot on
	   a flag and this is where it is acted on. */
	int lost_voice = voice_lost_take();
	while (lost_voice >= 0) {
		people_reassign_lost_voice(lost_voice);
		staff_reassign_lost_voice(lost_voice);
		lost_voice = voice_lost_take();
	}

	people_tick(now);
	people_spawn_tick(now);
	trouble_tick(now);
	cashier_chatter_tick(now);

	/* The cashier on shift serves the queue when you are not on the till. */
	worker@ cashier = staff_on_duty(ROLE_CASHIER);
	if (@cashier !is null and g_modal != MODAL_REGISTER and people_queue_length() > 0) {
		if (now >= g_next_cashier_serve) {
			g_next_cashier_serve = now + uint(cashier_serve_interval_ms(cashier));
			cashier_serve_one(cashier);
		}
	}
	/* The forecourt's own business: a pump that has finished handing its island
	   back, and whether anybody is out there with an engine running. */
	fuel_tick(now);
	fuel_set_waiting(people_fuel_waiting());
	music_trouble_tick();
	music_tick();
}

/* ==========================================================================
   18.  THE DEMO SHOP BEHIND THE MAIN MENU
   --------------------------------------------------------------------------
   The shop does not fall silent when the player is at the main menu. Its room
   tone is already playing - the beacons in rooms.nvgt run from startup - and
   this adds the parts of a shop that only people make: the door, feet, the till,
   a customer or two talking, a delivery outside, the office terminal, the odd
   cough or ring. A listener who cannot see the window can then tell that the
   game is waiting for them at a shop that is working, rather than at a dead
   screen.

   It is a demo and not a simulation: the same short script every time, nothing
   bought, nothing paid for, nobody served, and nothing written to a save. It is
   deliberately not the store's own customers spawning behind the menu, which
   would need the clock, the shelves and a save to run against.

   Two rules it keeps. Nothing plays until the audio walk has finished, because
   a shop of placeholder tones is a shop of beeps. And it can be turned off in
   Options, because a player reading the menu with a screen reader is exactly
   the person an attract mode must not talk over.
   ========================================================================== */

bool g_demo_shop_enabled = true;   /* Options, main menu */
bool g_demo_on = false;
uint g_demo_next_at = 0;
int  g_demo_event = 0;

/* How long after the cue before it, each cue plays, in milliseconds. Entry 0 is
   both the lead-in when the demo starts and the lull before the cycle begins
   again, which is why it is the long one. */
array<int> g_demo_gap;

void demo_script_init() {
	g_demo_gap.resize(0);
	g_demo_gap.insert_last(12000);  /* 0  the lead-in, and the lull between cycles */
	g_demo_gap.insert_last(1500);   /* 1  the door opens */
	g_demo_gap.insert_last(520);    /* 2  feet, left */
	g_demo_gap.insert_last(400);    /* 3  and further in */
	g_demo_gap.insert_last(400);    /* 4  and further */
	g_demo_gap.insert_last(400);    /* 5  at the counter */
	g_demo_gap.insert_last(620);    /* 6  the register */
	g_demo_gap.insert_last(380);    /* 7  the scanner */
	g_demo_gap.insert_last(420);    /* 8  change into the drawer */
	g_demo_gap.insert_last(1400);   /* 9  a customer says something */
	g_demo_gap.insert_last(1100);   /* 10 another one answers */
	g_demo_gap.insert_last(1000);   /* 11 feet, turning away */
	g_demo_gap.insert_last(420);    /* 12 past the aisle */
	g_demo_gap.insert_last(420);    /* 13 and out */
	g_demo_gap.insert_last(520);    /* 14 the door shuts */
	g_demo_gap.insert_last(2600);   /* 15 the terminal in the back office */
	g_demo_gap.insert_last(3400);   /* 16 a delivery out on the forecourt */
	g_demo_gap.insert_last(2600);   /* 17 somebody coughs, and a phone rings */
}

/* One cue of the demo. A menu is not a place in the shop, so these are panned
   rather than positioned - the same reason the chip's own blips are panned.
   The gains are the ones the game plays the same recordings at on the shop
   floor, so the demo is the shop's own level rather than a quieter imitation of
   it. */
void demo_cue(const string&in soundfile, float pan, float gain, int cut_ms = 0, double offset = 0.0) {
	if (@g_pool is null or !g_power_on) return;
	int slot = g_pool.play_stationary_extended(soundfile, false, offset, pan, gain, 100.0);
	if (slot >= 0) sfx_cut_after(slot, cut_ms);
}

/* One step of the walk through the demo shop: the shop's own tile step, from
   one of its three measured offsets, cut where the game cuts it. */
void demo_step(float pan, double offset) {
	demo_cue(A("step_tile.mp3"), pan, -10.5, FOOTSTEP_CUT_MS, offset);
}

/* A line from one of the shop's voices, and never from the player's. If the
   pool has nothing usable to speak with - which is the first minute or so on a
   machine whose voices are still being enumerated - the line is dropped rather
   than read out by the player's own channel: a customer speaking in the
   screen reader is worse than a quiet shop. */
int demo_voice_slot() {
	int n = voice_pool_count();
	if (n <= 0) return -1;
	int start = random(0, n - 1);
	for (int i = 0; i < n; i++) {
		int s = (start + i) % n;
		if (speech_slot_usable(s)) return s;
	}
	return -1;
}

void demo_voice_line(const string&in text) {
	int slot = demo_voice_slot();
	if (slot >= 0) say_as(slot, text, false);
}

/* The script itself, one case per cue in the same order as the gaps above. */
void demo_fire(int i) {
	switch (i) {
		case 0:  demo_cue(A("door_open.ogg"), -25.0, -11.0, 1300); break;
		case 1:  demo_step(-70.0, 7.02); break;
		case 2:  demo_step(-45.0, 10.26); break;
		case 3:  demo_step(-22.0, 13.26); break;
		case 4:  demo_step(0.0, 7.02); break;
		case 5:  demo_cue(A("register.ogg"), 10.0, -12.0, 900); break;
		case 6:  demo_cue(A("scanner.ogg"), 10.0, -16.0, 700); break;
		case 7:  demo_cue(A("coins.ogg"), 10.0, -13.0, 800); break;
		case 8:  demo_voice_line("Just these, thanks."); break;
		case 9:  demo_voice_line("Have you got a bag?"); break;
		case 10: demo_step(20.0, 10.26); break;
		case 11: demo_step(45.0, 13.26); break;
		case 12: demo_step(70.0, 7.02); break;
		case 13: demo_cue(A("door_close.ogg"), 20.0, -11.0, 1300); break;
		case 14: chip_say("STORE REPORT READY.", CHIP_DEVICE_COMPUTER, 40, -18.0); break;
		case 15: demo_cue(A("truck.mp3"), -30.0, -15.0, 3000); break;
		case 16: demo_cue(A(people_emote_file(EMO_COUGH)), -10.0, -15.0,
			people_emote_cut_ms(EMO_COUGH), people_emote_offset(EMO_COUGH)); break;
		case 17: demo_cue(A("ring.ogg"), 15.0, -14.0, 3500); break;
	}
}

void demo_shop_start() {
	g_demo_on = true;
	g_demo_event = 0;
	g_demo_next_at = ticks() + 1500;   /* a moment before the door opens */
	log_line("demo", "the demo shop is playing behind the main menu");
}

void demo_shop_stop() {
	if (!g_demo_on) return;
	g_demo_on = false;
	/* A machine line the demo asked for goes with it; nothing else of the
	   demo's is left hanging, because every other cue is a one-shot that cuts
	   itself off. */
	chip_stop_device(CHIP_DEVICE_COMPUTER);
	log_line("demo", "the demo shop stopped");
}

/* Called once a frame from the main loop, in every mode, so the demo can stop
   itself the moment a store is started or loaded. */
void demo_shop_tick() {
	bool wanted = (!g_game_mode and g_demo_shop_enabled and g_boot_state == BOOT_DONE
		and g_demo_gap.length() > 0);
	if (!wanted) { demo_shop_stop(); return; }
	if (!g_demo_on) demo_shop_start();
	if (ticks() < g_demo_next_at) return;
	demo_fire(g_demo_event);
	g_demo_event++;
	if (g_demo_event >= int(g_demo_gap.length())) g_demo_event = 0;
	g_demo_next_at = ticks() + uint(g_demo_gap[uint(g_demo_event)]);
}

/* ==========================================================================
   19.  SETUP
   ========================================================================== */

void mechanics_init() {
	g_menu.resize(0);
	g_modal = MODAL_NONE;
	g_slot = 1;
	g_game_mode = false;
	g_store_name = "Store Express";
	g_emails.resize(0);
	g_news.resize(0);
	sale_reset();
	g_music_tracks.resize(0);
	demo_script_init();      /* the shop heard behind the main menu */
	g_demo_shop_enabled = cfg_bool("menu_demo_shop", true);
	hardware_init();         /* the speech devices and their chips */
	log_line("mechanics", "mechanics ready");
}
