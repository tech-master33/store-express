/* ============================================================================
   Store Express  -  mechanics.nvgt
   ----------------------------------------------------------------------------
   The simulation's morning, and every screen the player talks to.

     * The clock and the day cycle: Monday's truck and job applicants, Friday's
       bill day, the market moving, your reputation being worked out, and the
       alcohol board's unpredictable inspection.
     * The till. Serving a customer is one page that changes under your cursor as
       you go: fetch what is behind the counter, scan each line, ask for
       identification, take the money, count out the change, print a receipt.
     * The manager terminal: restock orders, prices, reports, staff, policies,
       hours, music, insurance, loans, the declaration, the police record, and
       renaming the shop. A terminal that has never been set up in this store
       runs the hardware routine in hardware.nvgt first, and the store clock no
       longer stops for either: see clock_is_paused() below.
     * The phone: email, news and reviews.
     * Jail, and the fast forward that eats your business while you are inside.
     * The identification scanner and the alcohol board's fines and suspensions.
     * Saving into one of fifteen slots.

   ORDERING
     AngelScript has no function prototypes, so this file is written strictly
     bottom up. Globals first, then leaf helpers, then composites. If you move a
     function, keep it above everything that calls it.

   INCLUDE ORDER
     Included last, after every other module. This is the only file allowed to
     know about all of them at once.
   ========================================================================= */

/* ==========================================================================
   0.  CONSTANTS, MODALS AND EVERY GLOBAL
   ========================================================================= */

class menu_page {
	string title;
	array<string> labels;
	array<int> actions;
	int index;
	menu_page(const string&in t) { title = t; index = 0; }
	void add(const string&in label, int action) {
		labels.insert_last(label);
		actions.insert_last(action);
	}
	int count() { return int(labels.length()); }
}

/* The screen in front of the player (MODAL_NONE, MODAL_COMPUTER and the rest)
   is declared in core.nvgt, because hardware.nvgt takes the screen for itself
   and is included above this file. See section 4 of core.nvgt. */

