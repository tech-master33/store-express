	menu_page@ p = menu_page("Positions. Open one by Saturday and five applicants turn up on Monday");
	for (int r = 0; r < ROLE_COUNT; r++) {
		bool open = (g_positions_open.length() == ROLE_COUNT and g_positions_open[r] == 1);
		if (open) p.add("Close the position for a " + staff_role_name(r), ACT_STAFF_CLOSE_BASE + r);
		else p.add("Open a position for a " + staff_role_name(r), ACT_STAFF_OPEN_BASE + r);
	}
	p.add("Back", ACT_CLOSE);
