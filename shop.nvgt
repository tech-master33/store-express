/* ============================================================================
   Store Express  -  shop.nvgt
   ----------------------------------------------------------------------------
   The shop itself: what is on the shelves, what it costs, what it sells for, and
   how it gets there.

     * The catalogue. Every product has a name, a tagline, a category, a
       wholesale cost, a fair price that people round here expect to pay, a shelf
       price that you choose, and a stock count.
     * Twenty shelf faces across ten aisles, plus the restricted goods behind the
       counter. Each face is a separate run of shelves with its own stock.
     * Ordering: a draft order you build on the computer, paid for the moment you
       place it, arriving on the Monday truck.
     * The market. Wholesale costs move weekly, category by category, plus the
       odd shock, and a story in the local news usually comes first.
     * Pricing, one product at a time, a whole face, or everything at once, with
       a warning whenever a price is at or below what it costs you.
     * The reports the computer reads out: sales, stock levels, what is empty,
       best and worst rows, and how prices compare against the market.

   INCLUDE ORDER
     Included after money.nvgt. It never calls into staff, people, trouble,
     mechanics or main.

   WHY PRODUCTS ARE INDEXED
     Every product has one global index, and every table that needs to talk about
     products (the draft order, a customer's basket, the till log) uses that index
     rather than a name. That keeps basket math and save files small and exact.
   ========================================================================= */

/* ==========================================================================
   1.  CONSTANTS
   ========================================================================= */

const int FACE_COUNT = 20;           // ten aisles times two faces
const int FACE_COUNTER = -1;         // the restricted goods behind the counter

/* How much over the fair price people will put up with before they notice. */
const int PRICE_TOLERANCE_PCT = 15;

const int TRUCK_MINUTE = 6 * 60 + 30;    // Monday, half past six in the morning

/* ==========================================================================
   2.  THE PRODUCT
   ========================================================================= */

class product {
	string name;
	string tagline;
	string category;
	int    cost;         // what Ridgeline Wholesale charges you today, in cents
	int    fair;         // what people round here expect to pay
	int    price;        // your shelf price
	int    opening_cost; // what it cost when the shop opened, the market baseline
	int    stock;
	int    capacity;
	int    sold_since_delivery;
	int    revenue_since_delivery;
	int    face;         // index into the twenty faces, or FACE_COUNTER
	bool   restricted;   // beer, wine, spirits, tobacco and vapes
	product(const string&in n, const string&in t, const string&in c, int co, int fa, int fc, bool r) {
		name = n; tagline = t; category = c;
		cost = co; opening_cost = co; fair = fa; price = fa;
		stock = 0; capacity = 0; sold_since_delivery = 0; revenue_since_delivery = 0;
		face = fc; restricted = r;
	}
}

array<product@> g_catalog;

product@ product_at(int index) {
	if (index < 0 or uint(index) >= g_catalog.length()) return null;
	return g_catalog[index];
}

/* Round the fair price to the nearest five cents, which is how the reference
   prices a shelf: no one charges $2.47 for crisps. */
int fair_from_cost(int cost) {
	int raw = (cost * 155) / 100;
	return ((raw + 2) / 5) * 5;
}

/* How far above what people expect your price is, as a percentage. */
int shop_price_over_fair(int index) {
	product@ p = product_at(index);
	if (@p is null or p.fair <= 0) return 0;
	return ((p.price - p.fair) * 100) / p.fair;
}

/* True when the price is at or below what the stock cost you, which is a way to
   go broke politely. */
bool shop_below_cost(int index) {
	product@ p = product_at(index);
	if (@p is null) return false;
	return p.price <= p.cost;
}

/* ==========================================================================
   3.  BUILDING THE CATALOGUE
   ========================================================================= */

const int PRICE_RESTRICTED = -1;      // marker, not a price

void shop_add(const string&in name, const string&in tagline, const string&in category,
              int cost, int face, bool restricted) {
	product@ p = product(name, tagline, category, cost, fair_from_cost(cost), face, restricted);
	/* Shelf capacity varies a little per line so that the shelves do not all run
	   out on the same afternoon. */
	p.capacity = 12 + (int(g_catalog.length()) % 7) * 4;
	p.stock = p.capacity;
	g_catalog.insert_last(p);
}

