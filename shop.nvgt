/* ==========================================================================
   4.  FACES AND AISLES
   ========================================================================= */

string shop_face_theme(int face) {
	switch (face) {
		case 0:  return "crisps and corn snacks";
		case 1:  return "nuts, pretzels and jerky";
		case 2:  return "chocolate";
		case 3:  return "sweets and gum";
		case 4:  return "cookies and crackers";
		case 5:  return "breakfast and shelf stable meals";
		case 6:  return "soda multipacks";
		case 7:  return "mixers and drink concentrates";
		case 8:  return "protein snacks";
		case 9:  return "sports nutrition and hydration";
		case 10: return "bulk water and cooking staples";
		case 11: return "juice and canned food";
		case 12: return "coffee, cocoa and baking";
		case 13: return "tea, sweeteners and spreads";
		case 14: return "beer and party supplies";
		case 15: return "wine and cocktail supplies";
		case 16: return "paper goods";
		case 17: return "cleaning and hardware";
		case 18: return "automotive";
		case 19: return "travel and personal care";
	}
	return "the restricted goods behind the counter";
}

string shop_face_name(int face) {
	if (face == FACE_COUNTER) return "behind the counter";
	return "aisle " + (face / 2 + 1) + ((face % 2 == 0) ? " west face" : " east face");
}

int shop_face_of_aisle(int aisle, int which) { return aisle * 2 + which; }

/* How full a face is, as a percentage of what it can hold. */
int shop_face_stock_pct(int face) {
	int held = 0, room = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.face != face) continue;
		held += p.stock;
		room += p.capacity;
	}
	if (room <= 0) return 0;
	return (held * 100) / room;
}

int shop_out_of_stock_lines() {
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) if (g_catalog[i].stock <= 0) n++;
	return n;
}

int shop_out_of_stock_on_face(int face) {
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		if (g_catalog[i].face == face and g_catalog[i].stock <= 0) n++;
	}
	return n;
}

/* Somewhere in the catalogue, or null. */
product@ product_first_on_face(int face) {
	for (uint i = 0; i < g_catalog.length(); i++) if (g_catalog[i].face == face) return g_catalog[i];
	return null;
}

/* ==========================================================================
   5.  SELLING
   ========================================================================= */

/* Take quantity off the shelf and return what it earns. Callers check stock
   first; this is deliberately not forgiving. */
int shop_sell(int index, int qty) {
	product@ p = product_at(index);
	if (@p is null or qty <= 0) return 0;
	if (qty > p.stock) qty = p.stock;
	p.stock -= qty;
	int take = p.price * qty;
	p.sold_since_delivery += qty;
	p.revenue_since_delivery += take;
	return take;
}

/* Put goods back on the shelf and take them off the figures again, which is what
   a refused sale, a declined card or a customer who cannot cover the basket all
   need. Doing it with p.stock += n alone leaves the sold counters claiming the
   shop sold what it did not. */
int shop_unsell(int index, int qty) {
	product@ p = product_at(index);
	if (@p is null or qty <= 0) return 0;
	if (p.stock + qty > p.capacity) qty = p.capacity - p.stock;
	if (qty <= 0) return 0;
	int take = p.price * qty;
	p.stock += qty;
	p.sold_since_delivery -= qty;
	p.revenue_since_delivery -= take;
	if (p.sold_since_delivery < 0) p.sold_since_delivery = 0;
	if (p.revenue_since_delivery < 0) p.revenue_since_delivery = 0;
	return take;
}

/* A delivery resets every shelf's counters, so the reports always cover the same
   week, exactly as the reference requires. */
void shop_reset_sold_counters() {
	for (uint i = 0; i < g_catalog.length(); i++) {
		g_catalog[i].sold_since_delivery = 0;
		g_catalog[i].revenue_since_delivery = 0;
	}
}

/* ==========================================================================
   6.  PRICING
   ========================================================================= */

void shop_price_set(int index, int newprice) {
	product@ p = product_at(index);
	if (@p is null) return;
	if (newprice < 1) newprice = 1;
	p.price = newprice;
	string warn = "";
	if (shop_below_cost(index)) warn = " That is at or below what it costs you, so you lose money on every one.";
	else if (shop_price_over_fair(index) > PRICE_TOLERANCE_PCT) {
		warn = " That is " + shop_price_over_fair(index) + " percent over what people expect to pay, so they will buy fewer.";
	}
	say(p.name + " is now " + money(p.price) + "." + warn, true);
}

void shop_price_to_fair(int index) {
	product@ p = product_at(index);
	if (@p is null) return;
	p.price = p.fair;
	say(p.name + " is back to the fair price, " + money(p.price) + ".", true);
}

void shop_price_face(int face, int percent) {
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.face != face) continue;
		p.price = (p.price * (100 + percent)) / 100;
		if (p.price < 1) p.price = 1;
		n++;
	}
	sfx_ui(A("keyboard.ogg"), -20.0);
	say("Every price on " + shop_face_name(face) + " moved by " + signed_pct(percent) + ". "
		+ plural(n, "line", "lines") + " changed.", true);
}

int shop_face_price_warnings(int face) {
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.face != face) continue;
		if (p.price <= p.cost) n++;
	}
	return n;
}

void shop_price_face_to_fair(int face) {
	for (uint i = 0; i < g_catalog.length(); i++) {
		if (g_catalog[i].face == face) g_catalog[i].price = g_catalog[i].fair;
	}
	say("Every price on " + shop_face_name(face) + " is back to the fair price.", true);
}

int shop_prices_drifted() {
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) if (g_catalog[i].price != g_catalog[i].fair) n++;
	return n;
}

void shop_price_all_to_fair() {
	int n = shop_prices_drifted();
	for (uint i = 0; i < g_catalog.length(); i++) g_catalog[i].price = g_catalog[i].fair;
	say("Everything in the shop is back to the fair price. " + plural(n, "line", "lines") + " changed.", true);
}

/* ==========================================================================
   7.  ORDERING AND THE MONDAY TRUCK
   ========================================================================= */

/* The draft order: one quantity per catalogue index. It survives logging off, so
   a half built order is still there when you come back. */
array<int> g_draft_qty;

int  shop_draft_total() {
	int total = 0;
	for (uint i = 0; i < g_draft_qty.length(); i++) {
		if (g_draft_qty[i] <= 0) continue;
		product@ p = product_at(int(i));
		if (@p is null) continue;
		total += p.cost * g_draft_qty[i];
	}
	return total;
}

class order_rec {
	int arrive_day;
	int arrive_minute;
	int total;
	array<int> qty;
	int ordered_day;
	int ordered_week;
	order_rec(int ad, int am, int t, int od, int ow) {
		arrive_day = ad; arrive_minute = am; total = t; ordered_day = od; ordered_week = ow;
	}
}

array<order_rec@> g_orders;
/* Stock that came on the truck but would not fit on the shelves goes here,
   to be restocked by staff later when there is room. */
array<int> g_backroom_qty;

/* The truck comes Monday at half past six. Anything ordered Monday through
   Saturday comes on the next Monday; order on Sunday and it waits a whole extra
   week, which is the one rule everybody learns the hard way. */
int shop_next_delivery_day() {
	int w = int(g_current_day_of_week);
	if (w == SUNDAY) return int(g_current_day) + 8;
	int lead = (7 - w) % 7;
	if (lead == 0) lead = 7;
	return int(g_current_day) + lead;
}

void shop_order_add(int index, int qty) {
	product@ p = product_at(index);
	if (@p is null or qty <= 0) return;
	if (g_draft_qty.length() != g_catalog.length()) g_draft_qty.resize(g_catalog.length());
	g_draft_qty[index] += qty;
}

/* Add everything that is short to the draft order. */
void shop_order_fill_all() {
	g_draft_qty.resize(g_catalog.length());
	int lines = 0, units = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		int want = p.capacity - p.stock;
		if (want <= 0) continue;
		g_draft_qty[i] = want;
		lines++; units += want;
	}
	sfx_ui(A("keyboard.ogg"), -20.0);
	say("The draft order now covers " + plural(lines, "line", "lines") + ", " + plural(units, "unit", "units")
		+ ", for " + money(shop_draft_total()) + ". Nothing is ordered until you place it.", true);
}

void shop_order_fill_face(int face) {
	if (g_draft_qty.length() != g_catalog.length()) g_draft_qty.resize(g_catalog.length());
	int lines = 0, units = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.face != face) continue;
		int want = p.capacity - p.stock;
		if (want <= 0) continue;
		g_draft_qty[i] = want;
		lines++; units += want;
	}
	sfx_ui(A("keyboard.ogg"), -20.0);
	if (lines == 0) { say(shop_face_name(face) + " is already full.", true); return; }
	say(shop_face_name(face) + " added to the order: " + plural(lines, "line", "lines") + ", "
		+ plural(units, "unit", "units") + ", " + money(shop_draft_total()) + " in total.", true);
}

void shop_order_clear() {
	g_draft_qty.resize(0);
	say("The draft order is empty.", true);
}

/* Place the draft order. It is paid for the moment you place it. */
void shop_order_place() {
	if (g_draft_qty.length() == 0) { say("There is nothing in the order to place.", true); return; }
	int total = shop_draft_total();
	if (total <= 0) { say("There is nothing in the order to place.", true); return; }
	if (g_account_hold) {
		sfx_ui(A("knock.wav"), -10.0);
		say("Ridgeline Wholesale refuses the order. Your account is on hold because of the unpaid bill day. "
			+ "The draft is kept, so nothing is lost.", true);
		return;
	}
	if (!money_can_afford(total)) {
		say("The order comes to " + money(total) + " and the till holds " + money(g_cash)
			+ ". Ridgeline will not extend credit. The draft is kept.", true);
		return;
	}
	money_spend(total, 1);      // bucket 1 is stock
	order_rec@ o = order_rec(shop_next_delivery_day(), TRUCK_MINUTE, total, int(g_current_day), int(g_current_week));
	o.qty.resize(g_catalog.length());
	for (uint i = 0; i < g_catalog.length(); i++) o.qty[i] = (i < g_draft_qty.length()) ? g_draft_qty[i] : 0;
	g_orders.insert_last(o);
	g_draft_qty.resize(0);
	sfx_ui(A("register.ogg"), -8.0);
	say("Order placed and paid for, " + money(total) + ". It arrives on the truck on "
		+ day_name(MONDAY) + ", day " + o.arrive_day + ", at half past six in the morning. "
		+ "The till holds " + money(g_cash) + ".", true);
	log_line("shop", "order placed: " + money(total) + " arriving day " + o.arrive_day);
}

int shop_order_count() { return int(g_orders.length()); }

int shop_orders_total() {
	int t = 0;
	for (uint i = 0; i < g_orders.length(); i++) t += g_orders[i].total;
	return t;
}

string shop_orders_text() {
	if (g_orders.length() == 0) return "You have no orders on their way.";
	string s = plural(int(g_orders.length()), "order is", "orders are") + " on the way. ";
	for (uint i = 0; i < g_orders.length(); i++) {
		order_rec@ o = g_orders[i];
		s += "Order " + (i + 1) + ", " + money(o.total) + ", arriving on day " + o.arrive_day
			+ ", which is " + plural(o.arrive_day - int(g_current_day), "day", "days") + " from now. ";
	}
	return s;
}

void shop_cancel_order(int index) {
	if (index < 0 or uint(index) >= g_orders.length()) return;
	int refund = g_orders[uint(index)].total;
	g_cash += refund;
	g_wk_stock -= refund;
	if (g_wk_stock < 0) g_wk_stock = 0;
	g_orders.remove_at(uint(index));
	sfx_ui(A("coins.ogg"), -6.0);
	say("Order cancelled and refunded in full, " + money(refund) + ".", true);
}

/* The driver puts everything straight onto the shelves. There is no stockroom:
   anything that does not fit is paid for and lost. */
void shop_delivery_arrive(order_rec@ o) {
	int delivered = 0, wasted = 0, lines_short = 0;
	if (g_backroom_qty.length() != g_catalog.length()) {
		g_backroom_qty.resize(g_catalog.length());
		for (uint i = 0; i < g_backroom_qty.length(); i++) g_backroom_qty[i] = 0;
	}
	for (uint i = 0; i < o.qty.length() and i < g_catalog.length(); i++) {
		int qty = o.qty[i];
		if (qty <= 0) continue;
		product@ p = g_catalog[i];
		int room = p.capacity - p.stock;
		if (room <= 0) {
			g_backroom_qty[i] += qty;
			wasted += qty;
			lines_short++;
			continue;
		}
		int take = (qty > room) ? room : qty;
		p.stock += take;
		delivered += take;
		if (qty > take) {
			g_backroom_qty[i] += qty - take;
			wasted += qty - take;
			lines_short++;
		}
	}
	shop_reset_sold_counters();
	sfx_ui(A("truck.mp3"), -6.0);
	string s = "The truck is here. The driver puts " + plural(delivered, "unit", "units")
		+ " straight onto the shelves. ";
	if (wasted > 0) {
		s += plural(wasted, "unit", "units") + " would not fit on " + plural(lines_short, "line", "lines")
			+ ", so it has been paid for and lost. Order less next week, or sell more. ";
	}
	s += "Every shelf's sold since the last delivery counter has been reset, so this week's reports start now.";
	say(s, true);
	log_line("shop", "delivery: " + delivered + " units on, " + wasted + " wasted");
}

/* Called by mechanics.nvgt on every clock minute. Arrives at half past six. */
void shop_check_deliveries() {
	if (int(g_current_minute) != TRUCK_MINUTE % 60) return;
	if (int(g_current_hour) * 60 + int(g_current_minute) != TRUCK_MINUTE) return;
	for (int i = int(g_orders.length()) - 1; i >= 0; i--) {
		order_rec@ o = g_orders[i];
		if (int(g_current_day) != o.arrive_day) continue;
		shop_delivery_arrive(o);
		g_orders.remove_at(uint(i));
	}
	fuel_check_delivery();
}

/* ==========================================================================
   7b.  THE FUEL UNDER THE FORECOURT
   --------------------------------------------------------------------------
   The pumps sell what the tank under the forecourt holds. Everything here is
   shop state in whole litres and whole cents: the tank's level, what a litre
   cost on the wholesale market, what the sign by the road says a litre goes
   for, and any tanker load on its way.

   The shape of the trade is the real one, inside out: a driver pulls up at a
   pump, comes in and pays at the till for a stated number of litres, and goes
   back out to the car. Money changes hands before any fuel moves, so a
   drive-off cannot happen, and the whole sale goes through the queue, the
   wallet and the register that every other sale uses (see mechanics.nvgt).
   The pump's sound is part of the business rather than ambience: each of the
   four pumps owns a beacon that is registered switched off, and a fill
   switches it on where that pump stands (rooms.nvgt registers them,
   audio.nvgt runs them). An idle forecourt is a quiet forecourt.

   Fuel is ordered on its own, by the tanker load, from the same terminal and
   on the same Monday truck as everything else. It is store state and goes in
   the save as one line: litres, price, cost, and any load on the way.
   ========================================================================= */

const int FUEL_TANK_CAPACITY  = 2000;   // litres the tank under the forecourt holds
const int FUEL_TANK_START     = 800;    // what the previous owner left in it
const int FUEL_PRICE_START    = 175;    // cents per litre on the sign
const int FUEL_COST_START     = 112;    // cents per litre on the wholesale list
const int FUEL_COST_FLOOR     = 30;     // the market can only push a litre so low
const int FUEL_PRICE_FLOOR    = 5;      // and the sign can only be marked so low
const int FUEL_MARGIN_FAIR    = 60;     // the fair price is cost plus this
const int FUEL_PUMPS          = 4;
const int FUEL_FILL_MS_PER_LITRE = 1100; // a fill is heard for its length
const int FUEL_FILL_MIN_MS    = 6000;
const int FUEL_FILL_MAX_MS    = 45000;
const int FUEL_PUMP_CUT_MS    = 4500;   // the nozzle cue is cut here, like the doors

int g_fuel_litres = FUEL_TANK_START;
int g_fuel_price  = FUEL_PRICE_START;
int g_fuel_cost   = FUEL_COST_START;
int g_fuel_order_litres = 0;   // a tanker load placed and paid for
int g_fuel_order_day    = 0;   // the day it is due with the truck

/* One slot per pump: when its current fill ends (0 = standing still), and how
   many litres are on it, for the pump's own page and the logs. Litres that are
   paid for with every pump busy wait here for the next one to free up. */
array<uint> g_fuel_pump_until;
array<int>  g_fuel_pump_litres;
array<int>  g_fuel_pending;
uint g_fuel_next_check = 0;

void fuel_pumps_reset() {
	g_fuel_pump_until.resize(FUEL_PUMPS);
	g_fuel_pump_litres.resize(FUEL_PUMPS);
	for (int i = 0; i < FUEL_PUMPS; i++) { g_fuel_pump_until[i] = 0; g_fuel_pump_litres[i] = 0; }
	g_fuel_pending.resize(0);
	g_fuel_next_check = 0;
}

/* Called at startup and whenever a store is started or loaded: no pump is
   running, nothing is waiting, and every pump's sound is taken off. */
void fuel_init() {
	fuel_pumps_reset();
	for (int p = 1; p <= FUEL_PUMPS; p++) audio_beacon_enable(fuel_pump_beacon_id(p), false);
	audio_beacon_enable("an idling car", false);
}

int fuel_space() { return FUEL_TANK_CAPACITY - g_fuel_litres; }
int fuel_fair_price() { return g_fuel_cost + FUEL_MARGIN_FAIR; }
int fuel_fill_price(int litres) { return litres * g_fuel_price; }
void fuel_take(int litres) {
	g_fuel_litres -= litres;
	if (g_fuel_litres < 0) g_fuel_litres = 0;
}

string fuel_tank_text() {
	string s = plural(g_fuel_litres, "litre", "litres") + " in the tank";
	if (g_fuel_litres <= 0) s += ", which is dry";
	else if (fuel_space() > 0) s += ", " + fuel_space() + " short of full";
	return s;
}

int fuel_pumps_running() {
	int n = 0;
	uint now = ticks();
	if (g_fuel_pump_until.length() != FUEL_PUMPS) return 0;
	for (int i = 0; i < FUEL_PUMPS; i++) if (g_fuel_pump_until[i] > now) n++;
	return n;
}

/* The whole forecourt, for the terminal's reports and the phone. */
string shop_fuel_text() {
	string s = "The forecourt. ";
	if (g_fuel_litres <= 0) {
		s += "The tank under the pumps is dry, so nobody can be sold fuel. Order a load on the manager terminal and it comes with the truck on Monday morning.";
	} else {
		s += "The tank holds " + plural(g_fuel_litres, "litre", "litres") + " of unleaded";
		if (fuel_space() > 0) s += ", " + fuel_space() + " short of full";
		s += ". It cost " + money(g_fuel_cost) + " a litre on the wholesale list and goes at "
			+ money(g_fuel_price) + " a litre on the sign";
		if (g_fuel_price <= g_fuel_cost) {
			s += ", which is under what it cost you";
		} else {
			s += ", a margin of " + money(g_fuel_price - g_fuel_cost) + " a litre";
		}
		s += ".";
	}
	if (g_fuel_order_litres > 0) {
		s += " " + plural(g_fuel_order_litres, "load is", "loads are") + " on the tanker for day "
			+ g_fuel_order_day + ", which is " + plural(g_fuel_order_day - int(g_current_day), "day", "days") + " from now.";
	}
	int running = fuel_pumps_running();
	if (running > 0) s += " " + plural(running, "pump is", "pumps are") + " running out there.";
	return s;
}

/* The line the money report adds, and empty when there is nothing to say. */
string shop_fuel_orders_text() {
	if (g_fuel_order_litres <= 0) return "";
	return plural(g_fuel_order_litres, "litre", "litres") + " of fuel on the tanker, arriving day "
		+ g_fuel_order_day + ".";
}

/* Order a tanker load. Paid for the moment it is placed, like every other
   order, and it comes with the Monday truck. */
void fuel_order(int litres) {
	if (litres <= 0) return;
	int cost = litres * g_fuel_cost;
	if (g_account_hold) {
		sfx_ui(A("knock.wav"), -10.0);
		say("Ridgeline refuses the fuel order. Your account is on hold because of the unpaid bill day.", true);
		return;
	}
	if (!money_can_afford(cost)) {
		say("The load comes to " + money(cost) + " and the till holds " + money(g_cash)
			+ ". Ridgeline will not extend credit, so the tanker stays where it is.", true);
		return;
	}
	money_spend(cost, 1);
	g_fuel_order_litres += litres;
	g_fuel_order_day = shop_next_delivery_day();
	sfx_ui(A("register.ogg"), -8.0);
	say(plural(litres, "load", "loads") + " of unleaded, " + money(cost) + ", ordered and paid for. "
		+ "The tanker comes with the truck on " + day_name(MONDAY) + ", day " + g_fuel_order_day
		+ ", at half past six in the morning. The till holds " + money(g_cash) + ".", true);
	log_line("shop", "fuel ordered: " + litres + " litres arriving day " + g_fuel_order_day);
}

/* The tanker fills the tank when the truck comes. Called by
   shop_check_deliveries, which only runs at the truck's own minute. */
void fuel_check_delivery() {
	if (g_fuel_order_litres <= 0) return;
	if (int(g_current_day) < g_fuel_order_day) return;
	int litres = g_fuel_order_litres;
	g_fuel_order_litres = 0;
	g_fuel_order_day = 0;
	int space = fuel_space();
	int into = (litres > space) ? space : litres;
	g_fuel_litres += into;
	sfx_ui(A("truck.mp3"), -8.0);
	string s = "The fuel tanker is here. The driver hoses " + plural(into, "litre", "litres")
		+ " into the tank under the forecourt, which now holds " + plural(g_fuel_litres, "litre", "litres") + ". ";
	if (litres > into) {
		s += plural(litres - into, "litre was", "litres were") + " more than the tank holds and has gone back. "
			+ "Order to the space you have next time. ";
	}
	say(s, true);
	log_line("shop", "fuel delivery: " + into + " litres into the tank");
}

/* ---- running the pumps --------------------------------------------------
   A fill is heard where it happens and for as long as it takes: the nozzle
   cue, then the pump's own loop on its beacon until the litres are gone. This
   is the only thing in the game that switches a beacon on. */
void fuel_pump_run(int idx, int litres, const string&in who) {
	uint now = ticks();
	int ms = litres * FUEL_FILL_MS_PER_LITRE;
	if (ms < FUEL_FILL_MIN_MS) ms = FUEL_FILL_MIN_MS;
	if (ms > FUEL_FILL_MAX_MS) ms = FUEL_FILL_MAX_MS;
	g_fuel_pump_until[uint(idx)] = now + uint(ms);
	g_fuel_pump_litres[uint(idx)] = litres;
	audio_beacon_enable(fuel_pump_beacon_id(idx + 1), true);
	float px, py;
	fuel_pump_pos(idx + 1, px, py);
	sfx_at(ROOM_FORECOURT, px, py, 0.0, A("pump.mp3"), -8.0, FUEL_PUMP_CUT_MS);
	log_line("shop", "pump " + (idx + 1) + " running for " + litres + " litres, " + who);
}

/* Somebody has paid for fuel and walked back out to the car. If their pump is
   free it starts there and then; if every pump is busy their litres wait in
   line rather than being lost. */
void fuel_pump_start(int pump, int litres, const string&in who) {
	if (g_fuel_pump_until.length() != FUEL_PUMPS) fuel_pumps_reset();
	if (litres <= 0) return;
	if (pump < 1) pump = 1;
	if (pump > FUEL_PUMPS) pump = FUEL_PUMPS;
	int idx = pump - 1;
	if (g_fuel_pump_until[uint(idx)] > ticks()) {
		g_fuel_pending.insert_last(litres);
		log_line("shop", litres + " litres queued behind pump " + pump + ", " + who);
		return;
	}
	fuel_pump_run(idx, litres, who);
}

/* Once per frame from mechanics.nvgt: a pump that has finished hands its
   island back, its car is heard pulling away, and the next driver waiting gets
   the pump. */
void fuel_tick(uint now) {
	if (g_fuel_pump_until.length() != FUEL_PUMPS) return;
	if (now < g_fuel_next_check) return;
	g_fuel_next_check = now + 400;
	for (int i = 0; i < FUEL_PUMPS; i++) {
		if (g_fuel_pump_until[uint(i)] == 0) continue;
		if (now < g_fuel_pump_until[uint(i)]) continue;
		int litres = g_fuel_pump_litres[uint(i)];
		g_fuel_pump_until[uint(i)] = 0;
		g_fuel_pump_litres[uint(i)] = 0;
		audio_beacon_enable(fuel_pump_beacon_id(i + 1), false);
		float px, py;
		fuel_pump_pos(i + 1, px, py);
		/* The engine catches and the car goes: the recording is an idling engine,
		   so it is cut where the game cuts everything that outlasts its cue. */
		sfx_at(ROOM_FORECOURT, px, py, 0.0, A("car_idle.mp3"), -8.0, 2600);
		log_line("shop", "pump " + (i + 1) + " finished " + litres + " litres");
		if (g_fuel_pending.length() > 0) {
			int next = g_fuel_pending[0];
			g_fuel_pending.remove_at(0);
			fuel_pump_run(i, next, "the next driver");
		}
	}
}

/* The idling-car beacon means somebody is actually out there with an engine
   running: it is on while any driver is still in the shop on their way to or
   from the till, and the moment the last one is gone the forecourt is quiet
   again. Called every frame with the count from people.nvgt. */
void fuel_set_waiting(int drivers) {
	audio_beacon_enable("an idling car", drivers > 0);
}

/* ==========================================================================
   8.  THE MARKET
   --------------------------------------------------------------------------
   Wholesale costs follow real published consumer price figures, category by
   category, plus the odd shock: a story in the local news, a warning email from
   the wholesaler, and then costs move a few days later. Orders already placed
   keep the price they were placed at, so a warning is your chance to stock up.
   ========================================================================= */

class market_rec {
	string category;
	int    change_pct;
	market_rec(const string&in c, int p) { category = c; change_pct = p; }
}

array<market_rec@> g_market;
bool g_market_warning_out = false;

void shop_market_clear() { g_market.resize(0); }

void shop_market_set(const string&in category, int pct) {
	for (uint i = 0; i < g_market.length(); i++) {
		if (g_market[i].category == category) { g_market[i].change_pct = pct; return; }
	}
	g_market.insert_last(market_rec(category, pct));
}

int shop_market_change(const string&in category) {
	for (uint i = 0; i < g_market.length(); i++) {
		if (g_market[i].category == category) return g_market[i].change_pct;
	}
	return 0;
}

/* Apply a percentage move to every product in a category. */
void shop_market_apply(const string&in category, int pct) {
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.category != category) continue;
		p.cost = (p.cost * (100 + pct)) / 100;
		if (p.cost < 1) p.cost = 1;
	}
}

/* The one call the week makes. A handful of categories move, occasionally one of
   them violently, and the news says so first. */
void shop_market_week() {
	shop_market_clear();
	int moves = random(2, 4);
	string story = "";
	for (int i = 0; i < moves; i++) {
		int idx = random(0, int(g_catalog.length()) - 1);
		product@ p = product_at(idx);
		if (@p is null) continue;
		int pct = random(-4, 5);
		bool shock = (random(1, 100) <= 12);
		if (shock) pct = (pct >= 0) ? random(18, 34) : random(-24, -14);
		shop_market_set(p.category, pct);
		shop_market_apply(p.category, pct);
		if (shock) {
			story += (story.length() > 0) ? " " : "";
			story += "There is a story in the local news about " + p.category + ": costs there are "
				+ signed_pct(pct) + " this week. ";
		}
	}
	/* Fuel moves with the same market, on its own line: it is the one thing the
	   shop sells by the litre and orders by the tanker load, so its cost is
	   watched separately and quoted by name on the market report. */
	int fuel_pct = random(-5, 6);
	bool fuel_shock = (random(1, 100) <= 12);
	if (fuel_shock) fuel_pct = (fuel_pct >= 0) ? random(15, 26) : random(-20, -12);
	g_fuel_cost = (g_fuel_cost * (100 + fuel_pct)) / 100;
	if (g_fuel_cost < FUEL_COST_FLOOR) g_fuel_cost = FUEL_COST_FLOOR;
	shop_market_set("fuel", fuel_pct);
	if (fuel_shock and fuel_pct > 0) {
		story += (story.length() > 0) ? " " : "";
		story += "There is a refinery story on the news: wholesale fuel is " + signed_pct(fuel_pct)
			+ " this week, so a tanker load costs noticeably more. ";
	}
	g_market_warning_out = true;
	string s = "The wholesaler's price list has moved. ";
	/* Read the biggest movers first; nobody wants forty numbers. */
	for (uint i = 0; i < g_market.length(); i++) {
		s += g_market[i].category + " " + signed_pct(g_market[i].change_pct) + ". ";
	}
	if (story.length() > 0) s += story;
	s += "Orders you have already placed keep the price you placed them at, so a warning is your chance to stock up.";
	say(s, true);
	log_line("shop", "market week: " + g_market.length() + " categories moved");
}

/* ==========================================================================
   9.  THE REPORTS THE COMPUTER READS OUT
   ========================================================================= */

string shop_report_sales() {
	int units = 0, take = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		units += g_catalog[i].sold_since_delivery;
		take += g_catalog[i].revenue_since_delivery;
	}
	if (units == 0) return "Nothing has sold off the shelves since the last delivery.";
	return "Sales since the last delivery. " + plural(units, "unit", "units") + " sold for " + money(take) + ".";
}

string shop_report_levels() {
	string s = "How well stocked the shelves are. ";
	for (int f = 0; f < FACE_COUNT; f++) {
		int pct = shop_face_stock_pct(f);
		if (pct >= 90) continue;
		s += shop_face_name(f) + ", " + shop_face_theme(f) + ", " + pct + " percent full. ";
	}
	int counter = shop_face_stock_pct(FACE_COUNTER);
	s += "Behind the counter, " + counter + " percent full. ";
	if (s.length() < 60) s += "Everything else is nearly full. ";
	return s;
}

string shop_report_out_of_stock() {
	string s = "";
	int n = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.stock > 0) continue;
		s += p.name + " is empty. ";
		n++;
		if (n >= 12) { s += "And more. "; break; }
	}
	if (n == 0) return "Nothing is out of stock. The shelves are holding up.";
	return plural(shop_out_of_stock_lines(), "line is", "lines are") + " empty. " + s;
}

string shop_report_spend() {
	return "You have spent " + money(g_wk_stock) + " on stock this week. "
		+ shop_orders_text();
}

string shop_report_best_worst() {
	if (g_catalog.length() == 0) return "The shelves are empty.";
	int best = 0, worst = -1;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.revenue_since_delivery > g_catalog[best].revenue_since_delivery) best = int(i);
		if (worst < 0 or p.revenue_since_delivery < g_catalog[worst].revenue_since_delivery) worst = int(i);
	}
	product@ b = g_catalog[best];
	product@ w = g_catalog[worst];
	string s = "Best row since the last delivery: " + b.name + ", on " + shop_face_name(b.face)
		+ ", at " + money(b.revenue_since_delivery) + ", " + plural(b.sold_since_delivery, "unit", "units") + ". ";
	if (@w !is null and b.revenue_since_delivery > 0) {
		s += "Worst row: " + w.name + ", " + money(w.revenue_since_delivery) + ". ";
		if (w.sold_since_delivery == 0) s += "It sold nothing at all. ";
	}
	return s;
}

string shop_report_face(int face) {
	string s = shop_face_name(face) + ", " + shop_face_theme(face) + ". "
		+ shop_face_stock_pct(face) + " percent full. ";
	int units = 0, take = 0, empty = 0, lines = 0;
	for (uint i = 0; i < g_catalog.length(); i++) {
		product@ p = g_catalog[i];
		if (p.face != face) continue;
		lines++;
		units += p.sold_since_delivery;
		take += p.revenue_since_delivery;
		if (p.stock <= 0) empty++;
	}
	s += lines + " lines. ";
	if (units > 0) s += "It has sold " + plural(units, "unit", "units") + " for " + money(take) + " since the last delivery. ";
	else s += "Nothing has sold off it since the last delivery. ";
	if (empty > 0) s += plural(empty, "line is", "lines are") + " out of stock. ";
	return s;
}

string shop_product_text(int index) {
	product@ p = product_at(index);
	if (@p is null) return "There is no such product.";
	string s = p.name + ". " + p.tagline + ". It sells for " + money(p.price)
		+ " and costs you " + money(p.cost) + ". The fair price round here is " + money(p.fair) + ". ";
	int over = shop_price_over_fair(index);
	if (over > PRICE_TOLERANCE_PCT) s += "You are " + over + " percent over fair, so people buy fewer. ";
	if (p.price <= p.cost) s += "You are at or below cost. ";
	s += "You hold " + plural(p.stock, "unit", "units") + " out of " + p.capacity + ". ";
	if (p.sold_since_delivery > 0) s += "It has sold " + plural(p.sold_since_delivery, "unit", "units") + " for " + money(p.revenue_since_delivery) + " since the last delivery. ";
	if (p.restricted) s += "It is age restricted, so every sale needs a scan of the log. ";
	return s;
}

string shop_market_text() {
	string s = "The market. ";
	if (g_market.length() == 0) s += "Nothing has moved yet this week. ";
	for (uint i = 0; i < g_market.length(); i++) {
		s += g_market[i].category + " " + signed_pct(g_market[i].change_pct) + ". ";
	}
	s += "Wholesale costs follow published consumer price figures, category by category, with the odd shock.";
	return s;
}

/* ==========================================================================
   10.  SETUP
   ========================================================================= */

void shop_init() {
	catalog_build();
	g_draft_qty.resize(0);
	g_orders.resize(0);
	g_backroom_qty.resize(g_catalog.length());
	for (uint i = 0; i < g_backroom_qty.length(); i++) g_backroom_qty[i] = 0;
	shop_market_clear();
	log_line("shop", "shelves stocked: " + g_catalog.length() + " lines across "
		+ FACE_COUNT + " faces");
}
